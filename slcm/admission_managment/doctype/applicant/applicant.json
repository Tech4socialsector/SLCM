{
  "doctype": "DocType",
  "name": "Applicant",
  "module": "Admission Managment",
  "autoname": "naming_series:",
  "naming_series": "NLSIU-APP-.YYYY.-",
  "is_submittable": 1,
  "track_changes": 1,
  "title_field": "candidate_name",
  "fields": [
    {"fieldname": "section_application", "fieldtype": "Section Break", "label": "Application Info"},
    {"fieldname": "application_id", "fieldtype": "Data", "label": "Application ID", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "title", "fieldtype": "Select", "label": "Title", "options": "\nMr.\nMrs.\nMs.\nDr.\nProf."},
    {"fieldname": "application_type", "fieldtype": "Select", "label": "Application Type", "options": "\nCLAT\nNLSAT\nPACE", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "program", "fieldtype": "Link", "label": "Program", "options": "Program", "reqd": 1, "in_list_view": 1},
    {"fieldname": "campus", "fieldtype": "Link", "label": "Campus", "options": "Company", "reqd": 1},
    {"fieldname": "academic_year", "fieldtype": "Link", "label": "Academic Year", "options": "Admission Year", "reqd": 1},
    {"fieldname": "admission_cycle", "fieldtype": "Link", "label": "Admission Cycle", "options": "Admission Cycle"},
    {"fieldname": "application_status", "fieldtype": "Select", "label": "Application Status", "options": "\nDraft\nSubmitted\nUnder Evaluation\nShortlisted\nInterview Scheduled\nOffered\nAccepted\nRejected\nWaitlisted", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "amended_from", "fieldtype": "Link", "label": "Amended From", "options": "Applicant", "read_only": 1, "print_hide": 1},
    {"fieldname": "rejected_reason", "fieldtype": "Text", "label": "Rejected Reason", "depends_on": "eval:doc.application_status=='Rejected'"},
    {"fieldname": "section_personal", "fieldtype": "Section Break", "label": "Personal Details"},
    {"fieldname": "candidate_photo", "fieldtype": "Attach Image", "label": "Candidate Photo"},
    {"fieldname": "candidate_name", "fieldtype": "Data", "label": "Candidate Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "reqd": 1, "options": "Email", "in_standard_filter": 1},
    {"fieldname": "mobile_number", "fieldtype": "Data", "label": "Mobile Number", "reqd": 1},
    {"fieldname": "alternate_contact", "fieldtype": "Data", "label": "Alternate Contact"},
    {"fieldname": "gender", "fieldtype": "Select", "label": "Gender", "options": "\nMale\nFemale\nOther\nPrefer not to say"},
    {"fieldname": "date_of_birth", "fieldtype": "Date", "label": "Date of Birth", "reqd": 1},
    {"fieldname": "nationality", "fieldtype": "Data", "label": "Nationality"},
    {"fieldname": "religion", "fieldtype": "Data", "label": "Religion"},
    {"fieldname": "id_proof", "fieldtype": "Attach", "label": "ID Proof"},
    {"fieldname": "column_break_personal", "fieldtype": "Column Break"},
    {"fieldname": "source_of_information", "fieldtype": "Select", "label": "Source of Information", "options": "\nSocial Media\nFriend\nSchool\nAdvertisement\nOther"},
    {"fieldname": "please_mention", "fieldtype": "Data", "label": "Please Mention", "depends_on": "eval:doc.source_of_information=='Other'"},
    {"fieldname": "declaration_undertaking", "fieldtype": "Check", "label": "Declaration Undertaking", "reqd": 1},
    {"fieldname": "consent_third_party", "fieldtype": "Check", "label": "Consent Third Party"},
    {"fieldname": "section_family", "fieldtype": "Section Break", "label": "Family Details"},
    {"fieldname": "father_name", "fieldtype": "Data", "label": "Father Name"},
    {"fieldname": "father_email", "fieldtype": "Data", "label": "Father Email"},
    {"fieldname": "father_mobile", "fieldtype": "Data", "label": "Father Mobile"},
    {"fieldname": "father_occupation", "fieldtype": "Data", "label": "Father Occupation"},
    {"fieldname": "annual_house_hold_income", "fieldtype": "Currency", "label": "Annual House Hold Income"},
    {"fieldname": "column_break_family", "fieldtype": "Column Break"},
    {"fieldname": "mother_name", "fieldtype": "Data", "label": "Mother Name"},
    {"fieldname": "mother_email", "fieldtype": "Data", "label": "Mother Email"},
    {"fieldname": "mother_mobile", "fieldtype": "Data", "label": "Mother Mobile"},
    {"fieldname": "mother_occupation", "fieldtype": "Data", "label": "Mother Occupation"},
    {"fieldname": "section_guardian", "fieldtype": "Section Break", "label": "Guardian Details"},
    {"fieldname": "guardian_required", "fieldtype": "Check", "label": "Guardian Required"},
    {"fieldname": "guardian_name", "fieldtype": "Data", "label": "Guardian Name", "depends_on": "eval:doc.guardian_required==1", "mandatory_depends_on": "eval:doc.guardian_required==1"},
    {"fieldname": "guardian_mobile", "fieldtype": "Data", "label": "Guardian Mobile", "depends_on": "eval:doc.guardian_required==1"},
    {"fieldname": "guardian_email", "fieldtype": "Data", "label": "Guardian Email", "depends_on": "eval:doc.guardian_required==1"},
    {"fieldname": "section_address", "fieldtype": "Section Break", "label": "Correspondence Address"},
    {"fieldname": "correspondence_address", "fieldtype": "Text", "label": "Correspondence Address"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City"},
    {"fieldname": "state", "fieldtype": "Data", "label": "State"},
    {"fieldname": "pincode", "fieldtype": "Data", "label": "Pincode"},
    {"fieldname": "section_class_x", "fieldtype": "Section Break", "label": "Class X Details"},
    {"fieldname": "class_x_year_of_completion", "fieldtype": "Int", "label": "Class X Year of Completion"},
    {"fieldname": "class_x_school", "fieldtype": "Data", "label": "Class X School"},
    {"fieldname": "class_x_board", "fieldtype": "Data", "label": "Class X Board"},
    {"fieldname": "class_x_percentage", "fieldtype": "Float", "label": "Class X Percentage"},
    {"fieldname": "class_x_cgpa", "fieldtype": "Float", "label": "Class X CGPA"},
    {"fieldname": "class_x_marksheet", "fieldtype": "Attach", "label": "Class X Marksheet"},
    {"fieldname": "section_class_xii", "fieldtype": "Section Break", "label": "Class XII Details"},
    {"fieldname": "class_xii_exam_name", "fieldtype": "Data", "label": "Class XII Exam Name"},
    {"fieldname": "class_xii_year_of_completion", "fieldtype": "Int", "label": "Class XII Year of Completion"},
    {"fieldname": "class_xii_school", "fieldtype": "Data", "label": "Class XII School"},
    {"fieldname": "class_xii_board", "fieldtype": "Data", "label": "Class XII Board"},
    {"fieldname": "class_xii_percentage", "fieldtype": "Float", "label": "Class XII Percentage"},
    {"fieldname": "class_xii_cgpa", "fieldtype": "Float", "label": "Class XII CGPA"},
    {"fieldname": "class_xii_marksheet", "fieldtype": "Attach", "label": "Class XII Marksheet"},
    {"fieldname": "section_higher", "fieldtype": "Section Break", "label": "Higher Education"},
    {"fieldname": "ug_degree_completion", "fieldtype": "Select", "label": "UG Degree Completion", "options": "\nCompleted\nPursuing\nNot Applicable"},
    {"fieldname": "ug_degree_details", "fieldtype": "Text", "label": "UG Degree Details", "depends_on": "eval:doc.ug_degree_completion!='Not Applicable'"},
    {"fieldname": "post_degree_work_experience", "fieldtype": "Check", "label": "Post Degree Work Experience"},
    {"fieldname": "years_of_work_experience", "fieldtype": "Float", "label": "Years of Work Experience", "depends_on": "eval:doc.post_degree_work_experience==1"},
    {"fieldname": "section_reservation", "fieldtype": "Section Break", "label": "Reservation Category"},
    {"fieldname": "reservation_category", "fieldtype": "Select", "label": "Reservation Category", "options": "\nGeneral\nSC\nST\nOBC\nEWS\nPwD\nNRI\nKarnataka Domicile"},
    {"fieldname": "ews", "fieldtype": "Check", "label": "EWS", "depends_on": "eval:doc.reservation_category=='EWS'"},
    {"fieldname": "ews_certificate", "fieldtype": "Attach", "label": "EWS Certificate", "depends_on": "eval:doc.ews==1", "mandatory_depends_on": "eval:doc.ews==1"},
    {"fieldname": "caste_certificate", "fieldtype": "Attach", "label": "Caste Certificate", "depends_on": "eval:[\"SC\",\"ST\",\"OBC\"].includes(doc.reservation_category)", "mandatory_depends_on": "eval:[\"SC\",\"ST\",\"OBC\"].includes(doc.reservation_category)"},
    {"fieldname": "pwd", "fieldtype": "Check", "label": "PWD", "depends_on": "eval:doc.reservation_category=='PwD'"},
    {"fieldname": "pwd_required_test", "fieldtype": "Check", "label": "PWD Required Test", "depends_on": "eval:doc.pwd==1"},
    {"fieldname": "scribe_allotment", "fieldtype": "Check", "label": "Scribe Allotment", "depends_on": "eval:doc.pwd==1"},
    {"fieldname": "pwd_certificate", "fieldtype": "Attach", "label": "PWD Certificate", "depends_on": "eval:doc.pwd==1", "mandatory_depends_on": "eval:doc.pwd==1"},
    {"fieldname": "section_karnataka", "fieldtype": "Section Break", "label": "Karnataka Category"},
    {"fieldname": "karnataka_category", "fieldtype": "Check", "label": "Karnataka Category"},
    {"fieldname": "ka_study_7_years", "fieldtype": "Check", "label": "KA Study 7 Years", "depends_on": "eval:doc.karnataka_category==1"},
    {"fieldname": "ka_study_7_years_certificate", "fieldtype": "Attach", "label": "KA Study 7 Years Certificate", "depends_on": "eval:doc.ka_study_7_years==1"},
    {"fieldname": "ka_defence_child", "fieldtype": "Check", "label": "KA Defence Child", "depends_on": "eval:doc.karnataka_category==1"},
    {"fieldname": "ka_defence_certificate", "fieldtype": "Attach", "label": "KA Defence Certificate", "depends_on": "eval:doc.ka_defence_child==1"},
    {"fieldname": "ka_govt_child", "fieldtype": "Check", "label": "KA Govt Child", "depends_on": "eval:doc.karnataka_category==1"},
    {"fieldname": "ka_govt_certificate", "fieldtype": "Attach", "label": "KA Govt Certificate", "depends_on": "eval:doc.ka_govt_child==1"},
    {"fieldname": "ka_ais_child", "fieldtype": "Check", "label": "KA AIS Child", "depends_on": "eval:doc.karnataka_category==1"},
    {"fieldname": "ka_ais_certificate", "fieldtype": "Attach", "label": "KA AIS Certificate", "depends_on": "eval:doc.ka_ais_child==1"},
    {"fieldname": "ka_capf_child", "fieldtype": "Check", "label": "KA CAPF Child", "depends_on": "eval:doc.karnataka_category==1"},
    {"fieldname": "ka_capf_certificate", "fieldtype": "Attach", "label": "KA CAPF Certificate", "depends_on": "eval:doc.ka_capf_child==1"},
    {"fieldname": "section_preferences", "fieldtype": "Section Break", "label": "Campus Preferences"},
    {"fieldname": "first_preference", "fieldtype": "Link", "label": "First Preference", "options": "Company", "reqd": 1},
    {"fieldname": "second_preference", "fieldtype": "Link", "label": "Second Preference", "options": "Company"},
    {"fieldname": "third_preference", "fieldtype": "Link", "label": "Third Preference", "options": "Company"},
    {"fieldname": "section_documents", "fieldtype": "Section Break", "label": "Documents"},
    {"fieldname": "cv", "fieldtype": "Attach", "label": "CV"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Admission Admin", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "Admission Officer", "read": 1, "write": 1},
    {"role": "Evaluator", "read": 1},
    {"role": "Applicant", "read": 1, "write": 1, "create": 1}
  ]
}