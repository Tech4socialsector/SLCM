    {"fieldname": "round_number", "fieldtype": "Int", "label": "Round Number", "reqd": 1},
    {"fieldname": "round_type", "fieldtype": "Select", "label": "Round Type", "options": "\nApplication\nCounseling\nInterview\nMerit List\nDocument Verification\nFee Payment", "reqd": 1},
    {"fieldname": "application_start", "fieldtype": "Datetime", "label": "Application Start", "reqd": 1},
    {"fieldname": "application_end", "fieldtype": "Datetime", "label": "Application End", "reqd": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "\nUpcoming\nActive\nClosed", "default": "Upcoming", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Admission Admin", "read": 1, "write": 1, "create": 1},
    {"role": "Admission Officer", "read": 1}
  ]
}