  "response": "\n\n\n\n    <meta charset=\"UTF-8\">\n    <title>Merit List Published</title>\n\n\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f3f4f6;padding:20px 0\">\n        <tbody><tr>\n            <td align=\"center\">\n                <!-- Main Container -->\n                <table width=\"620\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e5e7eb\">\n                    <!-- Header -->\n                    <tbody><tr>\n                        <td style=\"background-color:#16a34a;padding:20px;text-align:center\">\n                            <h2 style=\"margin:0;color:#ffffff\">Merit List Published</h2>\n                            <p style=\"margin:5px 0 0;font-size:14px;color:#dcfce7\">\n                                {{ merit_list_name }}\n                            </p>\n                        </td>\n                    </tr>\n                    <!-- Content -->\n                    <tr>\n                        <td style=\"padding:25px\">\n                            <p style=\"font-size:15px;margin:0\">\n                                Dear <strong>{{ candidate_name }}</strong>,\n                            </p>\n                            <p style=\"font-size:14px;margin-top:12px;color:#374151\">\n                                We are pleased to inform you that the merit list has been published.\n                                You can now review your performance and admission status.\n                            </p>\n                            <!-- Merit Details Card -->\n                            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:20px;background-color:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:15px\">\n                                <tbody><tr>\n                                    <td style=\"font-weight:600;font-size:16px;color:#166534;padding-bottom:10px\">\n                                        Your Merit Details\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <td>\n                                        <table width=\"100%\" style=\"font-size:14px\">\n                                            <tbody><tr>\n                                                <td style=\"padding:6px 0;color:#374151\">Overall Rank</td>\n                                                <td style=\"padding:6px 0;text-align:right\">\n                                                    <strong>{{ overall_rank }}</strong>\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding:6px 0;color:#374151\">Merit Score</td>\n                                                <td style=\"padding:6px 0;text-align:right\">\n                                                    <strong>{{ total_score }} / 100</strong>\n                                                </td>\n                                            </tr>\n                                        </tbody></table>\n                                    </td>\n                                </tr>\n                            </tbody></table>\n                            <!-- Instructions -->\n                            <p style=\"font-size:14px;margin-top:20px;color:#374151\">\n                                Please log in to the applicant portal to:\n                            </p>\n                            <ul style=\"font-size:14px;margin:10px 0 0 18px;padding:0;color:#374151\">\n                                <li>View detailed merit breakdown</li>\n                                <li>Check your selection / waitlist status</li>\n                                <li>Proceed with seat allocation (if applicable)</li>\n                            </ul>\n                            <!-- CTA Button -->\n                            <div style=\"text-align:center;margin:30px 0\">\n                                <a href=\"{{ portal_link }}\" style=\"background-color:#16a34a;color:#ffffff;padding:12px 26px;text-decoration:none;border-radius:6px;font-weight:bold;display:inline-block\" rel=\"noopener noreferrer\">\n                                    View My Result\n                                </a>\n                            </div>\n                            <!-- Info Note -->\n                            <div style=\"background-color:#f9fafb;border-left:4px solid #16a34a;padding:12px;font-size:13px;color:#4b5563\">\n                                Note: Seat allocation and further admission steps will be available based on your merit rank and eligibility.\n                            </div>\n                        </td>\n                    </tr>\n                    <!-- Footer -->\n                    <tr>\n                        <td style=\"padding:20px;border-top:1px solid #e5e7eb;font-size:12px;color:#6b7280;text-align:center\">\n                            <p style=\"margin:0\">Published on: {{ published_date }}</p>\n                            <p style=\"margin:5px 0 0\">\n                                This is an automated notification from the Admission System. Please do not reply.\n                            </p>\n                        </td>\n                    </tr>\n                </tbody></table>\n            </td>\n        </tr>\n    </tbody></table>\n\n\n",
  "response_html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Merit List Published</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #f3f4f6; font-family: 'Segoe UI', Arial, sans-serif;\">\n\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f3f4f6; padding: 20px 0;\">\n        <tr>\n            <td align=\"center\">\n\n                <!-- Main Container -->\n                <table width=\"620\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 10px; overflow: hidden;\">\n\n                    <!-- Header -->\n                    <tr>\n                        <td style=\"background-color:#920C24; padding: 20px; text-align: center;\">\n                            <h2 style=\"margin: 0; color: #ffffff;\">Merit List Published</h2>\n                            <p style=\"margin: 5px 0 0; font-size: 14px; color: #fbcfe8;\">\n                                {{ merit_list_name }}\n                            </p>\n                        </td>\n                    </tr>\n\n                    <!-- Content -->\n                    <tr>\n                        <td style=\"padding: 25px;\">\n\n                            <p style=\"font-size: 15px; margin: 0;\">\n                                Dear <strong>{{ candidate_name }}</strong>,\n                            </p>\n\n                            <p style=\"font-size: 14px; margin-top: 12px;\">\n                                We are pleased to inform you that the merit list has been published.\n                                You can now review your performance and admission status.\n                            </p>\n\n                            <!-- Merit Details Card -->\n                            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n                                   style=\"margin-top: 20px; background-color: #fff1f2; border: 1px solid #fecdd3; border-radius: 8px; padding: 15px;\">\n                                \n                                <tr>\n                                    <td style=\"font-weight: 600; font-size: 16px; color: #920C24; padding-bottom: 10px;\">\n                                        Your Merit Details\n                                    </td>\n                                </tr>\n\n                                <tr>\n                                    <td>\n                                        <table width=\"100%\" style=\"font-size: 14px;\">\n                                            <tr>\n                                                <td style=\"padding: 6px 0; color: #374151;\">Overall Rank</td>\n                                                <td style=\"padding: 6px 0; text-align: right;\">\n                                                    <strong>{{ overall_rank }}</strong>\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 6px 0; color: #374151;\">Merit Score</td>\n                                                <td style=\"padding: 6px 0; text-align: right;\">\n                                                    <strong>{{ total_score }} / 100</strong>\n                                                </td>\n                                            </tr>\n                                        </table>\n                                    </td>\n                                </tr>\n                            </table>\n\n                            <!-- Instructions -->\n                            <p style=\"font-size: 14px; margin-top: 20px;\">\n                                Please log in to the applicant portal to:\n                            </p>\n\n                            <ul style=\"font-size: 14px; margin: 10px 0 0 18px; padding: 0;\">\n                                <li>View