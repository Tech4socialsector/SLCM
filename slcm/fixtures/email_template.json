  "response_html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Scholarship Application Update</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f3f4f6;font-family:'Segoe UI',Arial,sans-serif;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:20px 0;background:#f3f4f6;\">\n<tr>\n<td align=\"center\">\n\n<table width=\"620\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:10px;overflow:hidden;\">\n\n    <!-- HEADER -->\n    <tr>\n        <td style=\"background:#920C24;padding:25px;text-align:center;\">\n            <h2 style=\"margin:0;color:#ffffff;\">Scholarship Update</h2>\n            <p style=\"margin:5px 0 0;color:#fbcfe8;font-size:13px;\">\n                {{ scheme_name }}\n            </p>\n        </td>\n    </tr>\n\n    <!-- CONTENT -->\n    <tr>\n        <td style=\"padding:25px;\">\n\n            <p style=\"margin:0;font-size:15px;\">\n                Dear <strong>{{ applicant_name }}</strong>,\n            </p>\n\n            <!-- APPROVED -->\n            {% if status == \"Approved\" %}\n\n            <div style=\"margin-top:20px;background:#fff1f2;border:1px solid #fecdd3;border-radius:8px;padding:15px;\">\n                <p style=\"margin:0 0 8px;font-weight:600;color:#920C24;\">\n                    🎉 Scholarship Approved\n                </p>\n                <p style=\"margin:0;font-size:14px;color:#374151;\">\n                    Your scholarship application has been successfully approved.\n                </p>\n            </div>\n\n            <table width=\"100%\" style=\"margin-top:20px;font-size:14px;\">\n                <tr>\n                    <td style=\"padding:6px 0;color:#6b7280;\">Application ID</td>\n                    <td style=\"text-align:right;\"><strong>{{ application_id }}</strong></td>\n                </tr>\n                <tr>\n                    <td style=\"padding:6px 0;color:#6b7280;\">Scheme</td>\n                    <td style=\"text-align:right;\"><strong>{{ scheme_name }}</strong></td>\n                </tr>\n                <tr>\n                    <td style=\"padding:6px 0;color:#6b7280;\">Benefit</td>\n                    <td style=\"text-align:right;\"><strong>{{ benefit_amount }}</strong></td>\n                </tr>\n            </table>\n\n            <p style=\"margin-top:20px;font-size:14px;\">\n                The approved benefit has been applied to your fee. Please log in to view updated fee details and proceed with payment if required.\n            </p>\n\n            {% else %}\n\n            <!-- REJECTED -->\n            <div style=\"margin-top:20px;background:#fff1f2;border:1px solid #fecdd3;border-radius:8px;padding:15px;\">\n                <p style=\"margin:0 0 8px;font-weight:600;color:#920C24;\">\n                    Scholarship Application Update\n                </p>\n                <p style=\"margin:0;font-size:14px;color:#374151;\">\n                    We regret to inform you that your scholarship application was not approved.\n                </p>\n            </div>\n\n            <p style=\"margin-top:20px;font-size:14px;\">\n                Reason: <strong>{{ rejection_reason or \"Eligibility criteria not met / Limited availability\" }}</strong>\n            </p>\n\n            <p style=\"margin-top:10px;font-size:14px;\">\n                You may explore other available scholarship schemes on the portal.\n            </p>\n\n            {% endif %}\n\n            <!-- CTA -->\n            <div style=\"text-align:center;margin:30px 0;\">\n                <a href=\"{{ portal_link }}\"\n                   style=\"background:#920C24;color:#ffffff;padding:12px 25px;text-decoration:none;border-radius:6px;font-weight:600;\">\n                    Go to Portal\n                </a>\n            </div>\n\n            <!-- FOOTER NOTE -->\n            <div style=\"border-top:1px solid #e5e7eb;padding-top:15px;font-size:12px;color:#6b7280;text-align:center;\">\n                <p style=\"margin:0;\">This is an automated notification. Please do not reply.</p>\n            </div>\n\n        </td>\n    </tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
  "subject": "Scholarship Application Update – {{ scheme_name }}",
  "use_html": 1
 }
