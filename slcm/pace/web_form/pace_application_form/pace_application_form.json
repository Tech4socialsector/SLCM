 "custom_css": "/* \u2500\u2500 Modernized Web Form Style \u2500\u2500 */\n\n/* 1. Global Container & Background */\n.page_content { \n    max-width: 100% !important; \n}\n\n.web-form-container {\n    max-width: 100% !important; /* Form shouldn't be TOO wide for readability */\n}\n\n/* 2. Inputs & Controls */\n.control-value, .attached-file {\n    height: 42px !important; /* Slightly taller for modern feel */\n    background: #ffffff !important;\n    border: 1.5px solid #e5e7eb !important; /* Lighter, thicker border */\n    border-radius: 8px !important; /* Rounded corners */\n    padding: 0 12px !important;\n    transition: border-color 0.2s, box-shadow 0.2s !important;\n    font-size: 14px !important;\n    color: #374151 !important;\n    padding: 8px 12px !important;\n}\n\n/* Interactive Focus State */\n.control-value:focus, .attached-file:focus {\n    border-color: #3b82f6 !important;\n    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1) !important;\n    outline: none !important;\n}\n\n.form-control {\n    height: 42px !important; /* Slightly taller for modern feel */\n    background: #f8fafc !important;\n    border: 1.5px solid #e5e7eb !important; /* Lighter, thicker border */\n    border-radius: 8px !important; /* Rounded corners */\n    transition: border-color 0.2s, box-shadow 0.2s !important;\n    font-size: 14px !important;\n    color: #374151 !important;\n}\n/* 3. Headers & Typography */\n.section-head {\n    color: #2931cc !important; /* Deep slate instead of royal blue */\n    font-weight: 700 !important;\n    font-size: 1.25rem !important;\n    margin-bottom: 20px !important;\n    padding-bottom: 8px;\n}\n\n/* 4. Buttons (Next/Previous) */\n.btn-next, .btn-previous {\n    height: 40px !important;\n    padding: 0 30px !important;\n    border-radius: 8px !important;\n    font-weight: 600 !important;\n    border: none !important;\n    transition: transform 0.1s, background-color 0.2s !important;\n    cursor: pointer !important;\n}\n\n.btn-next , .submit-btn {\n    background: #2563eb !important; /* Modern Primary Blue */\n    color: white !important;\n}\n\n.btn-next , .submit-btn:hover {\n    background: #1d4ed8 !important;\n}\n\n.btn-previous {\n    background: #ffffff !important;\n    border: 1px solid #d1d5db !important;\n    color: #4b5563 !important;\n}\n\n.btn-previous:hover {\n    background: #f3f4f6 !important;\n}\n\n/* 5. Special Elements */\n.not-saved-badge { /* If you have a class for that 'Not Saved' text */\n    background-color: #fef3c7 !important;\n    color: #92400e !important;\n    padding: 2px 8px !important;\n    border-radius: 99px !important;\n    font-size: 12px !important;\n    font-weight: 500 !important;\n}\n.web-form-head {\n    padding-bottom: 1.25rem !important;\n    border-bottom: 0px solid var(--dark-border-color) !important;\n}\n.web-form-header {\n    border-bottom: 1px solid var(--dark-border-color) !important;\n}\n.control-input > textarea {\n    height: 170px;\n}\n.container {\n    padding:none !important;\n    min-width: 100% !important\n}",
