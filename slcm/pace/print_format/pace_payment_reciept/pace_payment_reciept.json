 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n\n<!-- \ud83d\udd25 NEW PREMIUM FONTS -->\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n:root {\n    --crimson: #8b1a1a;\n    --crimson-deep: #5c1010;\n    --gold: #b8963e;\n    --ink: #1a1a1a;\n    --slate: #4a5568;\n    --mist: #8a9bb0;\n    --rule: #dde3ea;\n    --paper: #ffffff;\n}\n\n/* Global */\nbody {\n    font-family: 'Inter', sans-serif;\n    font-size: 14px;\n    line-height: 1.6;\n}\n\n/* Receipt */\n.receipt {\n    background: var(--paper);\n    border-radius: 6px;\n    overflow: hidden;\n}\n\n/* Header */\n.receipt-head {\n    background: var(--crimson);\n    padding: 28px 40px;\n    display: flex;\n    justify-content: space-between;\n}\n\n.univ-name {\n    font-family: 'Playfair Display', serif;\n    font-size: 22px;\n    font-weight: 600;\n    color: #fff;\n}\n\n.univ-meta {\n    font-size: 11px;\n    color: rgba(255,255,255,0.7);\n    margin-top: 4px;\n}\n\n.head-right {\n    text-align: right;\n}\n\n.doc-type {\n    font-size: 10px;\n    color: rgba(255,255,255,0.6);\n    letter-spacing: 0.1em;\n}\n\n.doc-title {\n    font-family: 'Playfair Display', serif;\n    font-size: 26px;\n    color: #fff;\n}\n\n.doc-sub {\n    font-size: 12px;\n    color: rgba(255,255,255,0.7);\n}\n\n/* Gold line */\n.gold-rule {\n    height: 3px;\n    background: linear-gradient(90deg, var(--gold), #d4af6b, var(--gold));\n}\n\n/* Status */\n.status-strip {\n    background: #f0fdf4;\n    padding: 10px 40px;\n    font-size: 12px;\n    font-weight: 600;\n    color: #166534;\n    display: flex;\n    justify-content: space-between;\n}\n\n/* Body */\n.receipt-body {\n    padding: 36px 40px;\n}\n\n/* Section title */\n.section-head {\n    font-size: 11px;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--crimson);\n    margin-bottom: 16px;\n}\n\n/* Grid */\n.info-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px 30px;\n    margin-bottom: 30px;\n}\n\n.info-label {\n    font-size: 11px;\n    color: var(--mist);\n    letter-spacing: 0.06em;\n}\n\n.info-value {\n    font-size: 15px;\n    font-weight: 500;\n    color: var(--ink);\n}\n\n/* Table */\n.fee-table {\n    width: 100%;\n    border-collapse: collapse;\n}\n\n.fee-table th {\n    font-size: 11px;\n    color: var(--slate);\n    border-bottom: 1px solid var(--rule);\n    padding-bottom: 8px;\n}\n\n.fee-table td {\n    padding: 14px 0;\n    border-bottom: 1px solid var(--rule);\n}\n\n/* Total */\n.totals-wrap {\n    margin-top: 20px;\n}\n\n.totals-row {\n    display: flex;\n    justify-content: space-between;\n    margin-top: 10px;\n}\n\n.totals-label {\n    font-size: 12px;\n    color: var(--slate);\n}\n\n.totals-amount {\n    font-family: 'Playfair Display', serif;\n    font-size: 30px;\n    color: var(--crimson);\n}\n\n/* Footer */\n.receipt-footer {\n    padding: 20px 40px;\n    font-size: 12px;\n    color: var(--mist);\n    border-top: 1px solid var(--rule);\n}\n</style>\n</head>\n\n<body>\n\n<div class=\"receipt\">\n\n<!-- Header -->\n<div class=\"receipt-head\">\n    <div>\n        <div class=\"univ-name\">National Law School of India University</div>\n        <div class=\"univ-meta\">Bengaluru \u00b7 NAAC A++</div>\n    </div>\n    <div class=\"head-right\">\n        <div class=\"doc-type\">Document</div>\n        <div class=\"doc-title\">Fee Receipt</div>\n        <div class=\"doc-sub\">PACE Programme</div>\n    </div>\n</div>\n\n<div class=\"gold-rule\"></div>\n\n<!-- Status -->\n<div class=\"status-strip\">\n    <div>Payment Successful</div>\n    <div>{{ doc.name }}</div>\n</div>\n\n<!-- Body -->\n<div class=\"receipt-body\">\n\n<div class=\"section-head\">Applicant Details</div>\n\n<div class=\"info-grid\">\n    <div>\n        <div class=\"info-label\">Name</div>\n        <div class=\"info-value\">{{ doc.applicant_name }}</div>\n    </div>\n    <div>\n        <div class=\"info-label\">Application ID</div>\n        <div class=\"info-value\">{{ doc.pace_application }}</div>\n    </div>\n    <div>\n        <div class=\"info-label\">Programme</div>\n        <div class=\"info-value\">{{ doc.program }}</div>\n    </div>\n    <div>\n        <div class=\"info-label\">Payment Date</div>\n        <div class=\"info-value\">{{ doc.payment_date }}</div>\n    </div>\n</div>\n\n<div class=\"section-head\">Payment Details</div>\n\n<table class=\"fee-table\">\n<tr>\n    <th>Description</th>\n    <th style=\"text-align:right;\">Amount</th>\n</tr>\n<tr>\n    <td>PACE Programme Fee</td>\n    <td style=\"text-align:right;\">\u20b9 {{ doc.amount }}</td>\n</tr>\n</table>\n\n<div class=\"totals-wrap\">\n    <div class=\"totals-row\">\n        <div class=\"totals-label\">Total Paid</div>\n        <div class=\"totals-amount\">\u20b9 {{ doc.amount }}</div>\n    </div>\n</div>\n\n</div>\n\n<!-- Footer -->\n<div class=\"receipt-footer\">\nThis is a system-generated receipt. No signature required.\n</div>\n\n</div>\n\n</body>\n</html>",
