 "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n\n<style>\n:root {\n    --crimson: #8b1a1a;\n    --gold: #b8963e;\n    --text: #111111;\n    --muted: #444444;\n    --border: #d1d5db;\n    --bg: #ffffff;\n}\n\n/* IMPORTANT: PDF SAFE FONT STACK */\nbody {\n    font-family: \"Helvetica Neue\", Arial, sans-serif;\n    font-size: 14px;\n    color: var(--text);\n}\n\n/* Container */\n.receipt {\n    background: #fff;\n    max-width: 780px;\n    margin: auto;\n}\n\n/* Header */\n.receipt-head {\n    background: var(--crimson);\n    padding: 25px 35px;\n    display: flex;\n    justify-content: space-between;\n}\n\n.univ-name {\n    font-family: Georgia, serif;\n    font-size: 22px;\n    font-weight: bold;\n    color: #fff;\n}\n\n.univ-meta {\n    font-size: 12px;\n    color: rgba(255,255,255,0.8);\n}\n\n.doc-title {\n    font-family: Georgia, serif;\n    font-size: 24px;\n    color: #fff;\n    text-align: right;\n    font-weight: bold;\n}\n\n.doc-sub {\n    font-size: 12px;\n    color: rgba(255,255,255,0.8);\n    text-align: right;\n}\n\n/* Gold line */\n.gold-rule {\n    height: 3px;\n    background: var(--gold);\n}\n\n/* Status */\n.status-strip {\n    background: #e6f4ea;\n    padding: 10px 35px;\n    font-weight: bold;\n    font-size: 12px;\n    display: flex;\n    justify-content: space-between;\n    color: #065f46;\n}\n\n/* Body */\n.receipt-body {\n    padding: 30px 35px;\n}\n\n/* Section */\n.section-head {\n    font-size: 12px;\n    font-weight: bold;\n    color: var(--crimson);\n    margin-bottom: 15px;\n}\n\n/* Grid */\n.info-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 15px 25px;\n    margin-bottom: 25px;\n}\n\n.info-label {\n    font-size: 12px;\n    color: var(--muted);\n    font-weight: 600;\n}\n\n.info-value {\n    font-size: 15px;\n    font-weight: 600;\n    color: var(--text);\n}\n\n/* Table */\n.fee-table {\n    width: 100%;\n    border-collapse: collapse;\n}\n\n.fee-table th {\n    text-align: left;\n    border-bottom: 1px solid var(--border);\n    padding-bottom: 8px;\n    font-size: 12px;\n    color: var(--muted);\n}\n\n.fee-table td {\n    padding: 12px 0;\n    border-bottom: 1px solid var(--border);\n    font-size: 14px;\n}\n\n/* Total */\n.total {\n    display: flex;\n    justify-content: space-between;\n    margin-top: 20px;\n}\n\n.total-label {\n    font-size: 13px;\n    font-weight: bold;\n}\n\n.total-amount {\n    font-size: 24px;\n    font-weight: bold;\n    color: var(--crimson);\n}\n\n/* Footer */\n.footer {\n    border-top: 1px solid var(--border);\n    padding: 20px 35px;\n    font-size: 12px;\n    color: var(--muted);\n}\n</style>\n</head>\n\n<body>\n\n<div class=\"receipt\">\n\n<!-- Header -->\n<div class=\"receipt-head\">\n    <div>\n        <div class=\"univ-name\">National Law School of India University</div>\n        <div class=\"univ-meta\">Bengaluru \u00b7 NAAC A++</div>\n    </div>\n    <div>\n        <div class=\"doc-title\">Fee Receipt</div>\n        <div class=\"doc-sub\">PACE Programme</div>\n    </div>\n</div>\n\n<div class=\"gold-rule\"></div>\n\n<!-- Status -->\n<div class=\"status-strip\">\n    <div>Payment Successful</div>\n    <div>{{ doc.name }}</div>\n</div>\n\n<!-- Body -->\n<div class=\"receipt-body\">\n\n<div class=\"section-head\">APPLICANT DETAILS</div>\n\n<div class=\"info-grid\">\n    <div>\n        <div class=\"info-label\">Name</div>\n        <div class=\"info-value\">{{ doc.applicant_name }}</div>\n    </div>\n    <div>\n        <div class=\"info-label\">Application ID</div>\n        <div class=\"info-value\">{{ doc.pace_application }}</div>\n    </div>\n    <div>\n        <div class=\"info-label\">Programme</div>\n        <div class=\"info-value\">{{ doc.program }}</div>\n    </div>\n    <div>\n        <div class=\"info-label\">Payment Date</div>\n        <div class=\"info-value\">{{ doc.payment_date }}</div>\n    </div>\n</div>\n\n<div class=\"section-head\">PAYMENT DETAILS</div>\n\n<table class=\"fee-table\">\n<tr>\n    <th>Description</th>\n    <th style=\"text-align:right;\">Amount</th>\n</tr>\n<tr>\n    <td>PACE Programme Fee</td>\n    <td style=\"text-align:right;\">\u20b9 {{ doc.amount }}</td>\n</tr>\n</table>\n\n<div class=\"total\">\n    <div class=\"total-label\">Total Paid</div>\n    <div class=\"total-amount\">\u20b9 {{ doc.amount }}</div>\n</div>\n\n</div>\n\n<div class=\"footer\">\nThis is a system-generated receipt. No signature required.\n</div>\n\n</div>\n\n</body>\n</html>",
