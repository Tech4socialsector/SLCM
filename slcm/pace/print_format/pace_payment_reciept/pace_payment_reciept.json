 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>PACE Programme Fee Receipt \u2013 NLSIU</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap\" rel=\"stylesheet\">\n    <style>\n        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n\n        :root {\n            --crimson:      #8b1a1a;\n            --crimson-deep: #5c1010;\n            --gold:         #b8963e;\n            --gold-light:   #f5edd8;\n            --ink:          #1a1a1a;\n            --slate:        #4a5568;\n            --mist:         #8a9bb0;\n            --rule:         #dde3ea;\n            --paper:        #ffffff;\n            --bg:           #f0ece6;\n        }\n\n        body {\n            background: var(--bg);\n            font-family: 'Jost', sans-serif;\n            min-height: 100vh;\n            padding: 48px 20px;\n            display: flex;\n            justify-content: center;\n            align-items: flex-start;\n        }\n\n        .page {\n            width: 100%;\n            max-width: 780px;\n        }\n\n        /* \u2500\u2500 Print button \u2500\u2500 */\n        .no-print {\n            display: flex;\n            justify-content: flex-end;\n            margin-bottom: 20px;\n        }\n        .btn-print {\n            background: var(--crimson);\n            color: #fff;\n            border: none;\n            padding: 10px 24px;\n            font-family: 'Jost', sans-serif;\n            font-size: 13px;\n            font-weight: 500;\n            letter-spacing: 0.06em;\n            cursor: pointer;\n            border-radius: 2px;\n        }\n        .btn-print:hover { background: var(--crimson-deep); }\n\n        /* \u2500\u2500 Receipt shell \u2500\u2500 */\n        .receipt {\n            background: var(--paper);\n            box-shadow:\n                0 1px 3px rgba(0,0,0,.06),\n                0 20px 60px rgba(0,0,0,.10);\n        }\n\n        /* \u2500\u2500 Header band \u2500\u2500 */\n        .receipt-head {\n            background: var(--crimson);\n            padding: 32px 52px;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 24px;\n        }\n\n        .head-left { flex: 1; }\n\n        .univ-name {\n            font-family: 'Cormorant Garamond', Georgia, serif;\n            font-size: 24px;\n            font-weight: 600;\n            color: #fff;\n            line-height: 1.25;\n            letter-spacing: 0.01em;\n        }\n\n        .univ-meta {\n            font-size: 11px;\n            font-weight: 400;\n            color: rgba(255,255,255,0.6);\n            letter-spacing: 0.12em;\n            text-transform: uppercase;\n            margin-top: 5px;\n        }\n\n        .head-right {\n            text-align: right;\n            flex-shrink: 0;\n            border-left: 1px solid rgba(255,255,255,0.2);\n            padding-left: 32px;\n        }\n\n        .head-right .doc-type {\n            font-size: 10px;\n            font-weight: 500;\n            letter-spacing: 0.18em;\n            text-transform: uppercase;\n            color: rgba(255,255,255,0.55);\n            margin-bottom: 4px;\n        }\n\n        .head-right .doc-title {\n            font-family: 'Cormorant Garamond', serif;\n            font-size: 30px;\n            font-weight: 600;\n            color: #fff;\n            line-height: 1;\n        }\n\n        .head-right .doc-sub {\n            font-size: 12px;\n            font-weight: 400;\n            color: rgba(255,255,255,0.65);\n            margin-top: 5px;\n            letter-spacing: 0.04em;\n        }\n\n        /* \u2500\u2500 Gold accent rule \u2500\u2500 */\n        .gold-rule {\n            height: 3px;\n            background: linear-gradient(90deg, var(--gold) 0%, #d4af6b 50%, var(--gold) 100%);\n        }\n\n        /* \u2500\u2500 Status strip \u2500\u2500 */\n        .status-strip {\n            background: #f0fdf4;\n            border-bottom: 1px solid #bbf7d0;\n            padding: 11px 52px;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        .status-dot {\n            width: 7px;\n            height: 7px;\n            border-radius: 50%;\n            background: #16a34a;\n            flex-shrink: 0;\n        }\n\n        .status-text {\n            font-size: 12px;\n            font-weight: 600;\n            color: #166534;\n            letter-spacing: 0.08em;\n            text-transform: uppercase;\n        }\n\n        .status-id {\n            margin-left: auto;\n            font-size: 12px;\n            color: #166534;\n            font-weight: 400;\n            font-family: 'Courier New', monospace;\n        }\n\n        /* \u2500\u2500 Body \u2500\u2500 */\n        .receipt-body {\n            padding: 44px 52px;\n        }\n\n        /* \u2500\u2500 Section heading \u2500\u2500 */\n        .section-head {\n            font-size: 10px;\n            font-weight: 600;\n            letter-spacing: 0.16em;\n            text-transform: uppercase;\n            color: var(--crimson);\n            border-bottom: 1px solid var(--rule);\n            padding-bottom: 8px;\n            margin-bottom: 20px;\n        }\n\n        /* \u2500\u2500 Info grid \u2500\u2500 */\n        .info-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 20px 40px;\n            margin-bottom: 40px;\n        }\n\n        .info-item { }\n\n        .info-item.full {\n            grid-column: 1 / -1;\n        }\n\n        .info-label {\n            font-size: 10px;\n            font-weight: 600;\n            letter-spacing: 0.12em;\n            text-transform: uppercase;\n            color: var(--mist);\n            margin-bottom: 4px;\n        }\n\n        .info-value {\n            font-size: 15px;\n            font-weight: 500;\n            color: var(--ink);\n            line-height: 1.3;\n        }\n\n        .info-value.large {\n            font-size: 18px;\n            font-weight: 600;\n        }\n\n        .info-value.mono {\n            font-family: 'Courier New', monospace;\n            font-size: 13px;\n            color: var(--slate);\n            font-weight: 400;\n        }\n\n        /* \u2500\u2500 Horizontal rule \u2500\u2500 */\n        .h-rule {\n            border: none;\n            border-top: 1px solid var(--rule);\n            margin: 36px 0;\n        }\n\n        /* \u2500\u2500 Fee table \u2500\u2500 */\n        .fee-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 0;\n        }\n\n        .fee-table thead tr {\n            border-top: 1.5px solid var(--ink);\n            border-bottom: 1px solid var(--ink);\n        }\n\n        .fee-table th {\n            padding: 10px 0;\n            font-size: 10px;\n            font-weight: 600;\n            letter-spacing: 0.14em;\n            text-transform: uppercase;\n            color: var(--slate);\n        }\n        .fee-table th:last-child { text-align: right; }\n\n        .fee-table tbody tr {\n            border-bottom: 1px solid var(--rule);\n        }\n\n        .fee-table td {\n            padding: 18px 0;\n            vertical-align: top;\n            font-size: 14px;\n            color: var(--ink);\n        }\n        .fee-table td:last-child {\n            text-align: right;\n            font-weight: 600;\n            font-size: 15px;\n        }\n\n        .fee-desc {\n            font-size: 15px;\n            font-weight: 500;\n            color: var(--ink);\n            margin-bottom: 3px;\n        }\n        .fee-sub {\n            font-size: 12px;\n            color: var(--mist);\n            font-weight: 400;\n        }\n\n        /* \u2500\u2500 Totals \u2500\u2500 */\n        .totals-wrap {\n            border-top: 1.5px solid var(--ink);\n            margin-top: 0;\n        }\n\n        .totals-row {\n            display: flex;\n            justify-content: space-between;\n            align-items: baseline;\n            padding: 16px 0;\n            border-bottom: 1px solid var(--rule);\n        }\n        .totals-row:last-child { border-bottom: none; }\n\n        .totals-label {\n            font-size: 11px;\n            font-weight: 600;\n            letter-spacing: 0.1em;\n            text-transform: uppercase;\n            color: var(--slate);\n        }\n\n        .totals-amount {\n            font-family: 'Cormorant Garamond', serif;\n            font-size: 36px;\n            font-weight: 600;\n            color: var(--crimson);\n            letter-spacing: -0.01em;\n            line-height: 1;\n        }\n\n        .totals-words {\n            font-size: 13px;\n            font-style: italic;\n            color: var(--mist);\n            font-weight: 300;\n            text-align: right;\n            max-width: 380px;\n        }\n\n        /* \u2500\u2500 Footer \u2500\u2500 */\n        .receipt-footer {\n            border-top: 1px solid var(--rule);\n            padding: 24px 52px;\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            gap: 24px;\n            background: #fafaf9;\n        }\n\n        .footer-note {\n            font-size: 11px;\n            color: var(--mist);\n            line-height: 1.7;\n            max-width: 400px;\n        }\n\n        .footer-note strong {\n            font-size: 10px;\n            letter-spacing: 0.1em;\n            text-transform: uppercase;\n            color: var(--slate);\n            display: block;\n            margin-bottom: 4px;\n            font-weight: 600;\n        }\n\n        .footer-meta {\n            text-align: right;\n            flex-shrink: 0;\n        }\n\n        .footer-meta .meta-label {\n            font-size: 10px;\n            letter-spacing: 0.1em;\n            text-transform: uppercase;\n            color: var(--mist);\n            margin-bottom: 3px;\n        }\n\n        .footer-meta .meta-val {\n            font-size: 12px;\n            color: var(--slate);\n            font-weight: 500;\n        }\n\n        /* \u2500\u2500 Bottom crimson line \u2500\u2500 */\n        .receipt-base {\n            height: 4px;\n            background: var(--crimson);\n        }\n\n        /* \u2500\u2500 Print \u2500\u2500 */\n        @media print {\n            body { background: white; padding: 0; }\n            .no-print { display: none !important; }\n            .receipt { box-shadow: none; }\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"page\">\n\n    <div class=\"no-print\">\n        <button class=\"btn-print\" onclick=\"window.print()\">&#8595; Print / Save as PDF</button>\n    </div>\n\n    <div class=\"receipt\">\n\n        <!-- \u2500\u2500 Header \u2500\u2500 -->\n        <div class=\"receipt-head\">\n            <div class=\"head-left\">\n                <div class=\"univ-name\">National Law School of India University</div>\n                <div class=\"univ-meta\">Bengaluru, Karnataka &nbsp;\u00b7&nbsp; Established 1987 &nbsp;\u00b7&nbsp; NAAC A++</div>\n            </div>\n            <div class=\"head-right\">\n                <div class=\"doc-type\">Document Type</div>\n                <div class=\"doc-title\">Fee Receipt</div>\n                <div class=\"doc-sub\">PACE Programme</div>\n            </div>\n        </div>\n\n        <!-- \u2500\u2500 Gold rule \u2500\u2500 -->\n        <div class=\"gold-rule\"></div>\n\n        <!-- \u2500\u2500 Status strip \u2500\u2500 -->\n        <div class=\"status-strip\">\n            <div class=\"status-dot\"></div>\n            <div class=\"status-text\">Payment Confirmed</div>\n            <div class=\"status-id\">{{ doc.name }}</div>\n        </div>\n\n        <!-- \u2500\u2500 Body \u2500\u2500 -->\n        <div class=\"receipt-body\">\n\n            <!-- Applicant info -->\n            <div class=\"section-head\">Applicant & Payment Details</div>\n\n            <div class=\"info-grid\">\n                <div class=\"info-item full\">\n                    <div class=\"info-label\">Applicant Name</div>\n                    <div class=\"info-value large\">{{ doc.applicant_name }}</div>\n                </div>\n                <div class=\"info-item\">\n                    <div class=\"info-label\">Application ID</div>\n                    <div class=\"info-value\">{{ doc.pace_application }}</div>\n                </div>\n                <div class=\"info-item\">\n                    <div class=\"info-label\">Programme</div>\n                    <div class=\"info-value\">{{ doc.program }}</div>\n                </div>\n                <div class=\"info-item\">\n                    <div class=\"info-label\">Receipt Number</div>\n                    <div class=\"info-value mono\">{{ doc.name }}</div>\n                </div>\n                <div class=\"info-item\">\n                    <div class=\"info-label\">Payment Date</div>\n                    <div class=\"info-value\">\n                        {% if doc.payment_date %}\n                            {{ frappe.utils.format_datetime(doc.payment_date, \"dd MMM yyyy, HH:mm\") }}\n                        {% else %}\u2014{% endif %}\n                    </div>\n                </div>\n                <div class=\"info-item\">\n                    <div class=\"info-label\">Transaction ID</div>\n                    <div class=\"info-value mono\">{{ doc.transaction_id or 'N/A' }}</div>\n                </div>\n                {% if doc.academic_year %}\n                <div class=\"info-item\">\n                    <div class=\"info-label\">Academic Year</div>\n                    <div class=\"info-value\">{{ doc.academic_year }}</div>\n                </div>\n                {% endif %}\n            </div>\n\n            <hr class=\"h-rule\">\n\n            <!-- Fee breakdown -->\n            <div class=\"section-head\">Fee Breakdown</div>\n\n            <table class=\"fee-table\">\n                <thead>\n                    <tr>\n                        <th style=\"text-align:left; width:70%;\">Description</th>\n                        <th>Amount ({{ doc.currency or 'INR' }})</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <td>\n                            <div class=\"fee-desc\">PACE {{ doc.fee_type or 'Programme Fee' }}</div>\n                            {% if doc.academic_year %}\n                            <div class=\"fee-sub\">Academic Year: {{ doc.academic_year }}</div>\n                            {% endif %}\n                        </td>\n                        <td>{{ frappe.utils.fmt_money(doc.amount, currency=doc.currency) }}</td>\n                    </tr>\n                </tbody>\n            </table>\n\n            <!-- Totals -->\n            <div class=\"totals-wrap\">\n                <div class=\"totals-row\">\n                    <div class=\"totals-label\">Total Amount Paid</div>\n                    <div class=\"totals-amount\">\n                        {{ doc.currency or 'INR' }}&nbsp;{{ frappe.utils.fmt_money(doc.amount, currency=doc.currency) }}\n                    </div>\n                </div>\n                <div class=\"totals-row\">\n                    <div class=\"totals-label\">Amount in Words</div>\n                    <div class=\"totals-words\">\n                        {{ frappe.utils.money_in_words(doc.amount, doc.currency or 'INR') }}\n                    </div>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- \u2500\u2500 Footer \u2500\u2500 -->\n        <div class=\"receipt-footer\">\n            <div class=\"footer-note\">\n                <strong>Important Notice</strong>\n                This is a computer-generated receipt and does not require a physical signature.\n                Please retain this document for your records.\n                For queries, contact the PACE Programme Office, NLSIU, Bengaluru.\n            </div>\n            <div class=\"footer-meta\">\n                <div class=\"meta-label\">Generated On</div>\n                <div class=\"meta-val\">\n                    {{ frappe.utils.format_datetime(doc.generated_on, \"dd MMM yyyy, HH:mm:ss\") }}\n                </div>\n            </div>\n        </div>\n\n        <!-- \u2500\u2500 Base line \u2500\u2500 -->\n        <div class=\"receipt-base\"></div>\n\n    </div>\n</div>\n\n</body>\n</html>",
