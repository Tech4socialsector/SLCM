 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>PACE Programme Fee Receipt \u2013 NLSIU</title>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap');\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            --crimson: #920c24;\n            --crimson-dark: #6b0819;\n            --crimson-light: #f9ecee;\n            --ink: #0f172a;\n            --slate: #475569;\n            --mist: #94a3b8;\n            --rule: #cbd5e1;\n            --paper: #fffdf9;\n            --white: #ffffff;\n        }\n\n        body {\n            background: #e8e4de;\n            font-family: 'DM Sans', sans-serif;\n            display: flex;\n            justify-content: center;\n            align-items: flex-start;\n            min-height: 100vh;\n            padding: 40px 20px;\n        }\n\n        .receipt-wrapper {\n            width: 100%;\n            max-width: 760px;\n        }\n\n        /* \u2500\u2500 Outer card \u2500\u2500 */\n        .receipt {\n            background: var(--paper);\n            border-radius: 2px;\n            box-shadow:\n                0 2px 4px rgba(0,0,0,.06),\n                0 12px 40px rgba(0,0,0,.12),\n                0 0 0 1px rgba(0,0,0,.04);\n            overflow: hidden;\n            position: relative;\n        }\n\n        /* \u2500\u2500 Top crimson bar \u2500\u2500 */\n        .receipt-bar {\n            height: 6px;\n            background: linear-gradient(90deg, var(--crimson-dark) 0%, var(--crimson) 60%, #c0392b 100%);\n        }\n\n        /* \u2500\u2500 Header \u2500\u2500 */\n        .receipt-header {\n            padding: 36px 48px 28px;\n            display: flex;\n            align-items: flex-start;\n            justify-content: space-between;\n            border-bottom: 1px solid var(--rule);\n            gap: 24px;\n        }\n\n        .header-left {\n            flex: 1;\n        }\n\n        .university-name {\n            font-family: 'EB Garamond', Georgia, serif;\n            font-size: 22px;\n            font-weight: 600;\n            color: var(--crimson);\n            line-height: 1.25;\n            letter-spacing: 0.01em;\n        }\n\n        .university-sub {\n            font-size: 11px;\n            font-weight: 500;\n            color: var(--slate);\n            letter-spacing: 0.12em;\n            text-transform: uppercase;\n            margin-top: 4px;\n        }\n\n        .header-right {\n            text-align: right;\n            flex-shrink: 0;\n        }\n\n        .receipt-label {\n            font-size: 11px;\n            font-weight: 500;\n            letter-spacing: 0.14em;\n            text-transform: uppercase;\n            color: var(--mist);\n            margin-bottom: 4px;\n        }\n\n        .receipt-title {\n            font-family: 'EB Garamond', Georgia, serif;\n            font-size: 28px;\n            font-weight: 600;\n            color: var(--ink);\n            line-height: 1;\n        }\n\n        /* \u2500\u2500 Seal watermark \u2500\u2500 */\n        .receipt-body {\n            padding: 36px 48px;\n            position: relative;\n        }\n\n        .receipt-body::before {\n            content: 'NLSIU';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%) rotate(-30deg);\n            font-family: 'EB Garamond', serif;\n            font-size: 110px;\n            font-weight: 600;\n            color: rgba(146, 12, 36, 0.04);\n            letter-spacing: 0.2em;\n            pointer-events: none;\n            user-select: none;\n            white-space: nowrap;\n        }\n\n        /* \u2500\u2500 Info grid \u2500\u2500 */\n        .info-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 0;\n            margin-bottom: 32px;\n            border: 1px solid var(--rule);\n            border-radius: 4px;\n            overflow: hidden;\n        }\n\n        .info-cell {\n            padding: 14px 20px;\n            border-bottom: 1px solid var(--rule);\n            border-right: 1px solid var(--rule);\n        }\n\n        .info-cell:nth-child(even) {\n            border-right: none;\n        }\n\n        .info-cell:nth-last-child(-n+2) {\n            border-bottom: none;\n        }\n\n        .info-cell-full {\n            grid-column: 1 / -1;\n            padding: 14px 20px;\n            border-bottom: 1px solid var(--rule);\n            border-right: none;\n        }\n\n        .info-cell-full:last-child {\n            border-bottom: none;\n        }\n\n        .cell-label {\n            font-size: 10px;\n            font-weight: 600;\n            letter-spacing: 0.1em;\n            text-transform: uppercase;\n            color: var(--mist);\n            margin-bottom: 4px;\n        }\n\n        .cell-value {\n            font-size: 14px;\n            font-weight: 500;\n            color: var(--ink);\n            font-family: 'DM Sans', sans-serif;\n        }\n\n        .cell-value.mono {\n            font-family: 'Courier New', monospace;\n            font-size: 13px;\n            color: var(--slate);\n        }\n\n        /* \u2500\u2500 Line items \u2500\u2500 */\n        .items-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 0;\n        }\n\n        .items-table thead tr {\n            border-top: 2px solid var(--ink);\n            border-bottom: 1px solid var(--ink);\n        }\n\n        .items-table th {\n            padding: 12px 0;\n            font-size: 10px;\n            font-weight: 600;\n            letter-spacing: 0.12em;\n            text-transform: uppercase;\n            color: var(--slate);\n        }\n\n        .items-table th:last-child {\n            text-align: right;\n        }\n\n        .items-table tbody tr {\n            border-bottom: 1px solid var(--rule);\n        }\n\n        .items-table td {\n            padding: 20px 0;\n            font-size: 14px;\n            color: var(--ink);\n            vertical-align: top;\n        }\n\n        .items-table td:last-child {\n            text-align: right;\n            font-weight: 500;\n        }\n\n        .item-desc {\n            font-size: 15px;\n            font-weight: 500;\n            color: var(--ink);\n            margin-bottom: 4px;\n        }\n\n        .item-sub {\n            font-size: 12px;\n            color: var(--mist);\n        }\n\n        /* \u2500\u2500 Totals \u2500\u2500 */\n        .totals-section {\n            margin-top: 0;\n            border-top: 2px solid var(--ink);\n            padding-top: 0;\n        }\n\n        .total-row {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 18px 0;\n            border-bottom: 1px solid var(--rule);\n        }\n\n        .total-row:last-child {\n            border-bottom: none;\n        }\n\n        .total-label {\n            font-size: 11px;\n            font-weight: 600;\n            letter-spacing: 0.1em;\n            text-transform: uppercase;\n            color: var(--slate);\n        }\n\n        .total-amount {\n            font-family: 'EB Garamond', Georgia, serif;\n            font-size: 32px;\n            font-weight: 600;\n            color: var(--crimson);\n            letter-spacing: -0.01em;\n        }\n\n        .total-words {\n            font-size: 12px;\n            font-style: italic;\n            color: var(--mist);\n        }\n\n        /* \u2500\u2500 Status badge \u2500\u2500 */\n        .status-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 6px;\n            background: #ecfdf5;\n            color: #065f46;\n            border: 1px solid #a7f3d0;\n            border-radius: 20px;\n            padding: 4px 12px;\n            font-size: 11px;\n            font-weight: 600;\n            letter-spacing: 0.06em;\n            text-transform: uppercase;\n            margin-bottom: 32px;\n        }\n\n        .status-dot {\n            width: 6px;\n            height: 6px;\n            border-radius: 50%;\n            background: #10b981;\n        }\n\n        /* \u2500\u2500 Divider \u2500\u2500 */\n        .divider {\n            height: 1px;\n            background: repeating-linear-gradient(\n                90deg,\n                var(--rule) 0px,\n                var(--rule) 6px,\n                transparent 6px,\n                transparent 12px\n            );\n            margin: 32px 0;\n        }\n\n        /* \u2500\u2500 Footer \u2500\u2500 */\n        .receipt-footer {\n            padding: 24px 48px 32px;\n            border-top: 1px solid var(--rule);\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-end;\n            gap: 24px;\n        }\n\n        .footer-note {\n            font-size: 11px;\n            color: var(--mist);\n            line-height: 1.6;\n        }\n\n        .footer-note strong {\n            color: var(--slate);\n            display: block;\n            margin-bottom: 2px;\n        }\n\n        .generated-on {\n            text-align: right;\n            font-size: 11px;\n            color: var(--mist);\n            flex-shrink: 0;\n        }\n\n        .generated-on span {\n            display: block;\n            font-size: 10px;\n            letter-spacing: 0.08em;\n            text-transform: uppercase;\n            margin-bottom: 2px;\n        }\n\n        /* \u2500\u2500 Print styles \u2500\u2500 */\n        @media print {\n            body {\n                background: white;\n                padding: 0;\n            }\n            .receipt {\n                box-shadow: none;\n                border-radius: 0;\n            }\n            .no-print {\n                display: none !important;\n            }\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"receipt-wrapper\">\n\n    <!-- Print button (hidden on print) -->\n    <div class=\"no-print\" style=\"text-align:right; margin-bottom:16px;\">\n        <button onclick=\"window.print()\" style=\"\n            background: var(--crimson);\n            color: white;\n            border: none;\n            padding: 10px 22px;\n            border-radius: 4px;\n            font-family: 'DM Sans', sans-serif;\n            font-size: 13px;\n            font-weight: 500;\n            cursor: pointer;\n            letter-spacing: 0.04em;\n        \">\u2b07 Print / Save as PDF</button>\n    </div>\n\n    <div class=\"receipt\">\n\n        <!-- Top bar -->\n        <div class=\"receipt-bar\"></div>\n\n        <!-- Header -->\n        <div class=\"receipt-header\">\n            <div class=\"header-left\">\n                <!-- Replace src with an absolute URL to the NLSIU logo if available -->\n                <!-- <img src=\"https://example.com/nlsiu-logo.png\" alt=\"NLSIU Logo\" style=\"height:52px; margin-bottom:10px; display:block;\"> -->\n                <div class=\"university-name\">National Law School of India University</div>\n                <div class=\"university-sub\">Bengaluru, Karnataka \u00b7 Established 1987</div>\n            </div>\n            <div class=\"header-right\">\n                <div class=\"receipt-label\">Document Type</div>\n                <div class=\"receipt-title\">Fee Receipt</div>\n                <div style=\"margin-top:6px; font-size:12px; color:var(--slate); font-weight:500;\">PACE Programme</div>\n            </div>\n        </div>\n\n        <!-- Body -->\n        <div class=\"receipt-body\">\n\n            <!-- Payment confirmed badge -->\n            <div class=\"status-badge\">\n                <span class=\"status-dot\"></span>\n                Payment Confirmed\n            </div>\n\n            <!-- Info grid -->\n            <div class=\"info-grid\">\n                <div class=\"info-cell\">\n                    <div class=\"cell-label\">Receipt No.</div>\n                    <div class=\"cell-value\">{{ doc.name }}</div>\n                </div>\n                <div class=\"info-cell\">\n                    <div class=\"cell-label\">Payment Date</div>\n                    <div class=\"cell-value\">\n                        {% if doc.payment_date %}\n                            {{ frappe.utils.format_datetime(doc.payment_date, \"dd-MM-yyyy HH:mm\") }}\n                        {% else %}\n                            \u2014\n                        {% endif %}\n                    </div>\n                </div>\n                <div class=\"info-cell\">\n                    <div class=\"cell-label\">Application ID</div>\n                    <div class=\"cell-value\">{{ doc.pace_application }}</div>\n                </div>\n                <div class=\"info-cell\">\n                    <div class=\"cell-label\">Transaction ID</div>\n                    <div class=\"cell-value mono\">{{ doc.transaction_id or 'N/A' }}</div>\n                </div>\n                <div class=\"info-cell-full\">\n                    <div class=\"cell-label\">Applicant Name</div>\n                    <div class=\"cell-value\" style=\"font-size:16px;\">{{ doc.applicant_name }}</div>\n                </div>\n                <div class=\"info-cell-full\" style=\"border-bottom:none;\">\n                    <div class=\"cell-label\">Programme</div>\n                    <div class=\"cell-value\">{{ doc.program }}</div>\n                </div>\n            </div>\n\n            <!-- Line items -->\n            <table class=\"items-table\">\n                <thead>\n                    <tr>\n                        <th style=\"text-align:left;\">Description</th>\n                        <th>Amount ({{ doc.currency or 'INR' }})</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <td>\n                            <div class=\"item-desc\">PACE {{ doc.fee_type or 'Fee Payment' }}</div>\n                            {% if doc.academic_year %}\n                                <div class=\"item-sub\">Academic Year: {{ doc.academic_year }}</div>\n                            {% endif %}\n                        </td>\n                        <td>\n                            {{ frappe.utils.fmt_money(doc.amount, currency=doc.currency) }}\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n\n            <!-- Totals -->\n            <div class=\"totals-section\">\n                <div class=\"total-row\">\n                    <div class=\"total-label\">Total Amount Paid</div>\n                    <div class=\"total-amount\">\n                        {{ doc.currency or 'INR' }} {{ frappe.utils.fmt_money(doc.amount, currency=doc.currency) }}\n                    </div>\n                </div>\n                <div class=\"total-row\">\n                    <div class=\"total-label\">Amount in Words</div>\n                    <div class=\"total-words\">\n                        {{ frappe.utils.money_in_words(doc.amount, doc.currency or 'INR') }}\n                    </div>\n                </div>\n            </div>\n\n        </div><!-- /.receipt-body -->\n\n        <!-- Footer -->\n        <div class=\"receipt-footer\">\n            <div class=\"footer-note\">\n                <strong>Important Notice</strong>\n                This is a computer-generated receipt and does not require a physical signature.\n                Please retain this document for your records. For any queries, contact the\n                PACE Programme office at NLSIU, Bengaluru.\n            </div>\n            <div class=\"generated-on\">\n                <span>Generated On</span>\n                {{ frappe.utils.format_datetime(doc.generated_on, \"dd-MM-yyyy HH:mm:ss\") }}\n            </div>\n        </div>\n\n    </div><!-- /.receipt -->\n\n</div><!-- /.receipt-wrapper -->\n\n</body>\n</html>",
