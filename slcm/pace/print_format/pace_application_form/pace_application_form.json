 "doctype": "Print Format",
 "font_size": 14,
 "html": "{#- PACE Application \u2014 Precise 2-Page wkhtmltopdf Print Format -#}\n{%- macro f(v) -%}{%- if v and v != 'None' -%}{{ v }}{%- else -%}&mdash;{%- endif -%}{%- endmacro -%}\n{%- macro fd(v) -%}{%- if v -%}{{ frappe.utils.formatdate(v,'dd-MM-yyyy') }}{%- else -%}&mdash;{%- endif -%}{%- endmacro -%}\n{%- macro yn_text(v) -%}{{ \"Yes\" if v else \"No\" }}{%- endmacro -%}\n{%- macro yn(v) -%}{{ \"YES\" if v else \"NO\" }}{%- endmacro -%}\n{%- macro checkbox_model(label, value) -%}\n<tr>\n    <td style=\"width: 5%; text-align: center; vertical-align: top; padding: 5px; border: 1px solid #E0E0E0;\">\n        <div style=\"width: 12px; height: 12px; border: 1px solid #800000; display: inline-block; position: relative; text-align: center; line-height: 10px; font-size: 8pt; font-weight: bold; color: #800000;\">\n            {{ '&#10003;' if value else '' }}\n        </div>\n    </td>\n    <td style=\"width: 95%; padding: 5px; font-size: 8pt; line-height: 1.35; text-align: justify; border: 1px solid #E0E0E0;\">\n        {{ label }}\n    </td>\n</tr>\n{%- endmacro -%}\n\n{#- Asset Handling -#}\n{%- set _photo_src = frappe.get_url(doc.upload_student_photo) if doc.upload_student_photo else '' -%}\n{%- set _sig_src = frappe.get_url(doc.student_signature) if doc.student_signature else '' -%}\n{%- set _logo_path = frappe.db.get_single_value('Institution Settings','logo') -%}\n{%- set _logo_src = frappe.get_url(_logo_path) if _logo_path else '' -%}-\n\n<link href=\"https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap\" rel=\"stylesheet\">\n<style>\n    @page { size: A4 portrait; margin: 8mm; }\n    * { box-sizing: border-box; }\n    body { font-family: 'Merriweather', serif; font-size: 8pt; line-height: 1.25; color: #1a1a1a; margin: 0; padding: 0; background-color: #fff; }\n    \n    .pf-page { width: 100%; background: #fff; margin: 0; padding: 0; }\n    .pf-container { border: 1px solid #800000; width: 100%; margin-bottom: 8px; }\n    table { width: 100%; border-collapse: collapse; }\n    \n    .pf-section { background-color: #f0f0f0; border-bottom: 1px solid #800000; padding: 3px 10px; font-weight: normal; color: #800000; text-transform: uppercase; font-size: 8pt; }\n    \n    /* Label and Value alignment with \":\" */\n    .label-cell { color: #757575; font-size: 8pt; padding: 4px 0 4px 8px; border-bottom: 1px solid #E0E0E0; vertical-align: middle; width: 105px; white-space: nowrap; }\n    .colon-cell { color: #757575; font-size: 8pt; padding: 4px 5px; border-bottom: 1px solid #E0E0E0; vertical-align: middle; width: 10px; text-align: center; }\n    .value-cell { color: #1a1a1a; font-size: 8pt; padding: 4px 8px 4px 0; border-bottom: 1px solid #E0E0E0; vertical-align: middle; font-weight: normal; }\n    \n    .strict-table td { border: 1px solid #E0E0E0; padding: 4px 8px; vertical-align: middle; font-size: 8pt; font-weight: normal; }\n    .strict-table th { border: 1px solid #E0E0E0; padding: 4px 8px; vertical-align: middle; font-size: 8pt; font-weight: normal; background-color: #f9f9f9; color: #666; }\n    .strict-label { background-color: #f9f9f9; color: #666; font-size: 8pt; font-weight: normal; }\n    \n    .photo-frame { border: 1px solid #800000; padding: 4px; text-align: center; background: #fff; display: inline-block; }\n    img { max-width: 100%; height: auto; display: block; margin: 0 auto; }\n</style>\n\n<div class=\"pf-page\">\n<div class=\"pf-container\">\n    {#- Header: Logo Left, Text Center -#}\n    <table style=\"background-color: #800000; width: 100%;\">\n        <tr>\n            <td style=\"width: 25%; padding: 8px; vertical-align: middle; text-align: left;\">\n                <div style=\"background-color: #ffffff; padding: 4px; border-radius: 4px; display: inline-block; line-height: 0;\">\n                    {% if _logo_src %}<img src=\"{{ _logo_src }}\" style=\"max-height: 35px; width: auto; display: block;\">{% endif %}\n                </div>\n            </td>\n            <td style=\"width: 50%; text-align: center; vertical-align: middle; color: #ffffff !important; font-size: 10pt; font-weight: normal; white-space: nowrap;\">\n                Application No: {{ doc.name }}\n            </td>\n            <td style=\"width: 25%;\"></td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">1. Personal Information</div>\n    <table>\n        <tr>\n            <td class=\"label-cell\">Full Name</td><td class=\"colon-cell\">:</td><td class=\"value-cell\" style=\"width: 25%;\">\n                {%- set p_title = doc.title if (doc.title and doc.title|lower != 'none') else \"\" -%}\n                {%- set p_first = doc.first_name if (doc.first_name and doc.first_name|lower != 'none') else \"\" -%}\n                {%- set p_middle = doc.middle_name if (doc.middle_name and doc.middle_name|lower != 'none') else \"\" -%}\n                {%- set p_last = doc.last_name if (doc.last_name and doc.last_name|lower != 'none') else \"\" -%}\n                {{ (p_title + \" \" + p_first + \" \" + p_middle + \" \" + p_last).split() | join(\" \") }}\n            </td>\n            <td class=\"label-cell\">Status</td><td class=\"colon-cell\">:</td><td class=\"value-cell\" style=\"width: 20%;\">{{ doc.status }}</td>\n            <td rowspan=\"4\" style=\"width: 25%; padding: 5px; text-align: center; border-bottom: 1px solid #E0E0E0; vertical-align: middle;\">\n                <div class=\"photo-frame\">\n                    {% if _photo_src %}<img src=\"{{ _photo_src }}\" style=\"width: 85px; height: 105px;\">{% else %}<div style=\"height: 105px; width: 85px; line-height: 105px; color: #ccc; font-size: 7pt;\">PHOTO</div>{% endif %}\n                </div>\n            </td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Programme</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ f(doc.programme) }}</td>\n            <td class=\"label-cell\">Submission Date</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ fd(doc.submission_date) }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Gender</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ f(doc.gender) }}</td>\n            <td class=\"label-cell\">Date of Birth</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ fd(doc.date_of_birth) }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Mobile Number</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ f(doc.mobile_number) }}</td>\n            <td class=\"label-cell\">Nationality</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ f(doc.nationality) }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Category</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ f(doc.category) }}</td>\n            <td class=\"label-cell\">Differently-Abled</td><td class=\"colon-cell\">:</td><td class=\"value-cell\" colspan=\"2\">{{ f(doc.differently_abled) }}{{ \" (\" ~ doc.please_specify ~ \")\" if doc.please_specify }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Source</td><td class=\"colon-cell\">:</td><td class=\"value-cell\" colspan=\"5\">{{ f(doc.how_did_you_hear_about_us) }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Email Address</td><td class=\"colon-cell\">:</td><td class=\"value-cell\" colspan=\"5\">{{ f(doc.email_address) }}</td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">2.Employment Details</div>\n    <table>\n        <tr>\n            <td class=\"label-cell\">Employed</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ f(doc.currently_employed) }}</td>\n            <td class=\"label-cell\">Organization</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ f(doc.organization_name) }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Designation</td><td class=\"colon-cell\">:</td><td class=\"value-cell\" colspan=\"4\">{{ f(doc.designation) }}</td>\n        </tr>\n    </table>\n\n    <!--<div class=\"pf-section\">2. Passport Details</div>-->\n    <!--<table>-->\n    <!--    <tr>-->\n    <!--        <td class=\"label-cell\">Passport Number</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ f(doc.passport_number) }}</td>-->\n    <!--        <td class=\"label-cell\">Date of Expiry</td><td class=\"colon-cell\">:</td><td class=\"value-cell\">{{ fd(doc.date_of_expiry) }}</td>-->\n    <!--    </tr>-->\n    <!--</table>-->\n\n    <div class=\"pf-section\">3. Parent Details</div>\n    <table>\n        <tr>\n            <td class=\"label-cell\">Father's Name</td><td class=\"colon-cell\">:</td><td class=\"value-cell\"> {{ f(doc.father_name) }}</td>\n            <td class=\"label-cell\">Mother's Name</td><td class=\"colon-cell\">:</td><td class=\"value-cell\"> {{ f(doc.mother_name) }}</td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">4. Address Details</div>\n    <table class=\"strict-table\">\n        <tr class=\"strict-label\"><td colspan=\"6\" style=\"background-color: #f9f9f9; font-weight: normal; color: #800000; text-align: left; padding: 2px 8px;\">Correspondence Address</td></tr>\n        <tr>\n            <td class=\"strict-label\" style=\"width: 12%;\">Country</td><td style=\"width: 21%;\">{{ f(doc.country) }}</td>\n            <td class=\"strict-label\" style=\"width: 12%;\">State</td><td style=\"width: 21%;\">{{ f(doc.state) }}</td>\n            <td class=\"strict-label\" style=\"width: 12%;\">District</td><td style=\"width: 22%;\">{{ f(doc.district) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">City</td><td>{{ f(doc.city) }}</td>\n            <td class=\"strict-label\">Address Line 1</td><td colspan=\"3\">{{ f(doc.address_line_1) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">Pincode</td><td>{{ f(doc.pincode) }}</td>\n            <td class=\"strict-label\">Address Line 2</td><td colspan=\"3\">{{ f(doc.address_line_2) }}</td>\n        </tr>\n    </table>\n</div>\n\n<div style=\"page-break-before: always;\"></div>\n\n<div class=\"pf-container\">\n    <div class=\"pf-section\">5. Education Details (UG)</div>\n    <table class=\"strict-table\">\n        <thead>\n            <tr class=\"strict-label\">\n                <th style=\"width: 22%; text-align: left;\">Institution</th>\n                <th style=\"width: 22%; text-align: left;\">University</th>\n                <th style=\"width: 18%; text-align: left;\">Programme</th>\n                <th style=\"width: 10%; text-align: left;\">Year</th>\n                <th style=\"width: 14%; text-align: left;\">Result</th>\n                <th style=\"width: 14%; text-align: left;\">Marks/CGPA</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.ug_degree %}\n            <tr>\n                <td>{{ f(row.institution_name) }}</td>\n                <td>{{ f(row.university) }}</td>\n                <td>{{ f(row.programme_studied) }}</td>\n                <td>{{ f(row.year_of_passing) }}</td>\n                <td>{{ f(row.result_status) }}</td>\n                <td>{{ f(row.obtained_percentagecgpa) }} {{ \"(\" ~ row.marking_scheme ~ \")\" if row.marking_scheme }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <div class=\"pf-section\">6. Upload Documents</div>\n    <table class=\"strict-table\">\n        <tr>\n            <td class=\"strict-label\" style=\"width: 30%;\">Student Photo</td>\n            <td style=\"width: 20%; text-align: center;\">{% if _photo_src %}<img src=\"{{ _photo_src }}\" style=\"max-height: 50px;\">{% else %}&mdash;{% endif %}</td>\n            <td class=\"strict-label\" style=\"width: 30%;\">Student Signature</td>\n            <td style=\"width: 20%; text-align: center;\">{% if _sig_src %}<img src=\"{{ _sig_src }}\" style=\"max-height: 50px;\">{% else %}&mdash;{% endif %}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">UG Degree Certificate</td><td style=\"text-align: center;\">{{ yn(doc.ug_degree_certificate) }}</td>\n            <td class=\"strict-label\">Govt. ID (Passport for Foreign Nationals)</td><td style=\"text-align: center;\">{{ yn(doc.govt_id) }}</td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">7. Declaration</div>\n    <table class=\"strict-table\">\n        {{ checkbox_model(doc.meta.get_label(\"acknowledge_check\"), doc.acknowledge_check) }}\n        {{ checkbox_model(doc.meta.get_label(\"understand_check\"), doc.understand_check) }}\n        {{ checkbox_model(doc.meta.get_label(\"communication_check\"), doc.communication_check) }}\n    </table>\n    <table class=\"strict-table\">\n        <tr>\n            <td class=\"strict-label\" style=\"width: 20%;\">Applicant Name</td>\n            <td style=\"width: 30%; text-align: center;\">{{ f(doc.applicant_name) }}</td>\n            <td class=\"strict-label\" style=\"width: 20%;\">Submission Date</td>\n            <td style=\"width: 30%; text-align: center;\">{{ fd(doc.submission_date) }}</td>\n        </tr>\n    </table>\n    \n    <div style=\"padding: 5px; color: #999; font-size: 7.5pt; text-align: center; border-top: 1px solid #eee;\">\n        Generated on: {{ frappe.utils.format_datetime(frappe.utils.now_datetime(), \"dd-MM-yyyy HH:mm:ss\") }}\n    </div>\n</div>\n</div>\n",
