 "doctype": "Print Format",
 "font_size": 14,
 "html": "{#- PACE Application \u2014 Stable wkhtmltopdf Print Format -#}\n{%- macro f(v) -%}{%- if v and v != 'None' -%}{{ v }}{%- else -%}&mdash;{%- endif -%}{%- endmacro -%}\n{%- macro fd(v) -%}{%- if v -%}{{ frappe.utils.formatdate(v,'dd-MM-yyyy') }}{%- else -%}&mdash;{%- endif -%}{%- endmacro -%}\n{%- macro yn_text(v) -%}{{ \"Yes\" if v else \"No\" }}{%- endmacro -%}\n{%- macro yn(v) -%}{{ \"YES\" if v else \"NO\" }}{%- endmacro -%}\n\n{#- Asset Handling -#}\n{%- set _photo_src = frappe.get_url(doc.upload_student_photo) if doc.upload_student_photo else '' -%}\n{%- set _sig_src = frappe.get_url(doc.student_signature) if doc.student_signature else '' -%}\n{%- set _logo_path = frappe.db.get_single_value('Institution Settings','logo') -%}\n{%- set _logo_src = frappe.get_url(_logo_path) if _logo_path else '' -%}\n\n<style>\n    @page { size: A4 portrait; margin: 10mm; }\n    * { box-sizing: border-box; }\n    body { font-family: Arial, sans-serif; font-size: 9pt; line-height: 1.4; color: #1a1a1a; margin: 0; padding: 0; }\n    \n    .pf-container { border: 1px solid #800000; width: 100%; margin-bottom: 20px; }\n    table { width: 100%; border-collapse: collapse; }\n    \n    .pf-header-td { background-color: #800000 !important; color: #ffffff !important; padding: 10px; -webkit-print-color-adjust: exact; }\n    .pf-section { background-color: #f0f0f0; border-bottom: 1px solid #800000; padding: 5px 10px; font-weight: bold; color: #800000; text-transform: uppercase; }\n    \n    .label-cell { color: #757575; font-size: 8.5pt; padding: 8px 10px; border-bottom: 1px solid #E0E0E0; vertical-align: middle; }\n    .value-cell { color: #1a1a1a; font-size: 9pt; padding: 8px 10px; border-bottom: 1px solid #E0E0E0; vertical-align: middle; font-weight: bold; }\n    \n    .strict-table td { border: 1px solid #E0E0E0; padding: 8px 10px; vertical-align: middle; }\n    .strict-label { background-color: #f9f9f9; color: #666; font-size: 8.5pt; font-weight: normal; }\n    \n    .photo-frame { border: 1px solid #800000; padding: 5px; text-align: center; background: #fff; display: inline-block; }\n    .page-break { page-break-after: always; }\n    img { max-width: 100%; height: auto; }\n</style>\n\n<!-- SHEET 1 -->\n<div class=\"pf-container\">\n    {#- Header -#}\n    <table style=\"background-color: #800000;\">\n        <tr>\n            <td class=\"pf-header-td\" style=\"width: 110px; text-align: center; vertical-align: middle; padding: 10px;\">\n                <div style=\"background-color: #ffffff; padding: 6px; border-radius: 4px; display: inline-block; line-height: 0;\">\n                    {% if _logo_src %}<img src=\"{{ _logo_src }}\" style=\"max-height: 40px; width: auto; display: block;\">{% endif %}\n                </div>\n            </td>\n            <td class=\"pf-header-td\" style=\"text-align: center; font-size: 14pt; font-weight: bold; vertical-align: middle; color: #ffffff !important;\">\n                PACE APPLICATION FORM <br>\n                <span style=\"font-size: 10pt; color: #ffffff !important;\">Application No: {{ doc.name }}</span>\n            </td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">1. Basic Details</div>\n    <table>\n        <tr>\n            <td class=\"label-cell\" style=\"width: 15%;\">Application No</td>\n            <td class=\"value-cell\" style=\"width: 22%;\">{{ doc.name }}</td>\n            <td class=\"label-cell\" style=\"width: 15%;\">Status</td>\n            <td class=\"value-cell\" style=\"width: 23%;\">{{ doc.status }}</td>\n            <td rowspan=\"4\" style=\"width: 25%; padding: 10px; text-align: center; border-bottom: 1px solid #E0E0E0; vertical-align: middle;\">\n                <div class=\"photo-frame\">\n                    {% if _photo_src %}\n                    <img src=\"{{ _photo_src }}\" style=\"width: 100px; height: 120px; display: block; margin: 0 auto;\">\n                    {% else %}\n                    <div style=\"height: 120px; width: 100px; line-height: 120px; color: #ccc;\">PHOTO</div>\n                    {% endif %}\n                </div>\n            </td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Programme</td>\n            <td class=\"value-cell\">{{ f(doc.programme) }}</td>\n            <td class=\"label-cell\">Submission Date</td>\n            <td class=\"value-cell\">{{ fd(doc.submission_date) }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Full Name</td>\n            <td class=\"value-cell\" colspan=\"3\">{{ f(doc.title) }} {{ doc.first_name }} {{ f(doc.middle_name) }} {{ doc.last_name }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Gender</td>\n            <td class=\"value-cell\">{{ f(doc.gender) }}</td>\n            <td class=\"label-cell\">Date of Birth</td>\n            <td class=\"value-cell\">{{ fd(doc.date_of_birth) }}</td>\n        </tr>\n    </table>\n\n    <table>\n        <tr>\n            <td class=\"label-cell\" style=\"width: 20%;\">Email Address</td>\n            <td class=\"value-cell\" style=\"width: 30%;\">{{ f(doc.email_address) }}</td>\n            <td class=\"label-cell\" style=\"width: 20%;\">Mobile Number</td>\n            <td class=\"value-cell\" style=\"width: 30%;\">{{ f(doc.mobile_number) }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Nationality</td>\n            <td class=\"value-cell\">{{ f(doc.nationality) }}</td>\n            <td class=\"label-cell\">Category</td>\n            <td class=\"value-cell\">{{ f(doc.category) }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Differently-Abled</td>\n            <td class=\"value-cell\">{{ f(doc.differently_abled) }}{{ \" (\" ~ doc.please_specify ~ \")\" if doc.please_specify }}</td>\n            <td class=\"label-cell\">Source of Info</td>\n            <td class=\"value-cell\">{{ f(doc.how_did_you_hear_about_us) }}</td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">Employment Details</div>\n    <table>\n        <tr>\n            <td class=\"label-cell\" style=\"width: 20%;\">Currently Employed</td>\n            <td class=\"value-cell\" style=\"width: 30%;\">{{ f(doc.currently_employed) }}</td>\n            <td class=\"label-cell\" style=\"width: 20%;\">Organization Name</td>\n            <td class=\"value-cell\" style=\"width: 30%;\">{{ f(doc.organization_name) }}</td>\n        </tr>\n        <tr>\n            <td class=\"label-cell\">Designation</td>\n            <td class=\"value-cell\" colspan=\"3\">{{ f(doc.designation) }}</td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">2. Passport Details</div>\n    <table>\n        <tr>\n            <td class=\"label-cell\" style=\"width: 20%;\">Passport Number</td>\n            <td class=\"value-cell\" style=\"width: 30%;\">{{ f(doc.passport_number) }}</td>\n            <td class=\"label-cell\" style=\"width: 20%;\">Date of Expiry</td>\n            <td class=\"value-cell\" style=\"width: 30%;\">{{ fd(doc.date_of_expiry) }}</td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">3. Parent's Details</div>\n    <table>\n        <tr>\n            <td class=\"label-cell\" style=\"width: 20%;\">Father's Name</td>\n            <td class=\"value-cell\" style=\"width: 30%;\">{{ f(doc.father_title) }} {{ f(doc.father_name) }}</td>\n            <td class=\"label-cell\" style=\"width: 20%;\">Mother's Name</td>\n            <td class=\"value-cell\" style=\"width: 30%;\">{{ f(doc.mother_title) }} {{ f(doc.mother_name) }}</td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">4. Address Details</div>\n    <table class=\"strict-table\">\n        <tr>\n            <td class=\"strict-label\" colspan=\"6\" style=\"background-color: #f0f0f0; font-weight: bold; color: #800000; text-align: left;\">Address for Correspondence</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\" style=\"width: 12%;\">Country</td>\n            <td style=\"width: 21%;\">{{ f(doc.country) }}</td>\n            <td class=\"strict-label\" style=\"width: 12%;\">State</td>\n            <td style=\"width: 21%;\">{{ f(doc.state) }}</td>\n            <td class=\"strict-label\" style=\"width: 12%;\">District</td>\n            <td style=\"width: 22%;\">{{ f(doc.district) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">City</td>\n            <td>{{ f(doc.city) }}</td>\n            <td class=\"strict-label\">Addr L1</td>\n            <td colspan=\"3\">{{ f(doc.address_line_1) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">Addr L2</td>\n            <td>{{ f(doc.address_line_2) }}</td>\n            <td class=\"strict-label\">Pincode</td>\n            <td colspan=\"3\">{{ f(doc.pincode) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\" colspan=\"4\">Is Permanent Address Same As Address For Correspondence?</td>\n            <td colspan=\"2\" style=\"text-align: center;\">{{ yn_text(doc.is_permanent_address_same) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\" colspan=\"6\" style=\"background-color: #f0f0f0; font-weight: bold; color: #800000; text-align: left;\">Permanent Address</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">Country</td>\n            <td>{{ f(doc.p_country) }}</td>\n            <td class=\"strict-label\">State</td>\n            <td>{{ f(doc.p_state) }}</td>\n            <td class=\"strict-label\">District</td>\n            <td>{{ f(doc.p_district) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">City</td>\n            <td>{{ f(doc.p_city) }}</td>\n            <td class=\"strict-label\">Addr L1</td>\n            <td colspan=\"3\">{{ f(doc.p_address_line_1) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">Addr L2</td>\n            <td>{{ f(doc.p_address_line_2) }}</td>\n            <td class=\"strict-label\">Pincode</td>\n            <td colspan=\"3\">{{ f(doc.p_pincode) }}</td>\n        </tr>\n    </table>\n</div>\n\n<div class=\"page-break\"></div>\n\n<div class=\"pf-container\">\n    <div class=\"pf-section\">5. Education Details (UG)</div>\n    <table class=\"strict-table\">\n        <thead>\n            <tr class=\"strict-label\">\n                <th style=\"width: 18%; text-align: left; padding: 5px;\">Institution</th>\n                <th style=\"width: 18%; text-align: left; padding: 5px;\">University</th>\n                <th style=\"width: 18%; text-align: left; padding: 5px;\">Programme</th>\n                <th style=\"width: 10%; text-align: left; padding: 5px;\">Year</th>\n                <th style=\"width: 12%; text-align: left; padding: 5px;\">Result</th>\n                <th style=\"width: 10%; text-align: left; padding: 5px;\">Scheme</th>\n                <th style=\"width: 14%; text-align: left; padding: 5px;\">Marks/CGPA</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.ug_degree %}\n            <tr>\n                <td>{{ f(row.institution_name) }}</td>\n                <td>{{ f(row.university) }}</td>\n                <td>{{ f(row.programme_studied) }}</td>\n                <td>{{ f(row.year_of_passing) }}</td>\n                <td>{{ f(row.result_status) }}</td>\n                <td>{{ f(row.marking_scheme) }}</td>\n                <td>{{ f(row.obtained_percentagecgpa) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <div class=\"pf-section\">6. Upload Documents</div>\n    <table class=\"strict-table\">\n        <tr>\n            <td class=\"strict-label\" style=\"width: 30%;\">Upload Student Photo</td>\n            <td style=\"width: 20%; text-align: center;\">\n                {% if _photo_src %}<img src=\"{{ _photo_src }}\" style=\"max-height: 60px;\">{% else %} -- {% endif %}\n            </td>\n            <td class=\"strict-label\" style=\"width: 30%;\">Upload Student Signature</td>\n            <td style=\"width: 20%; text-align: center;\">\n                {% if _sig_src %}<img src=\"{{ _sig_src }}\" style=\"max-height: 60px;\">{% else %} -- {% endif %}\n            </td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">Upload UG Degree Certificate</td>\n            <td style=\"text-align: center;\">{{ yn(doc.ug_degree_certificate) }}</td>\n            <td class=\"strict-label\">Upload Self-signed, Self-declaration Document</td>\n            <td style=\"text-align: center;\">{{ yn(doc.self_declaration) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">Upload Passport / OCI Card</td>\n            <td style=\"text-align: center;\">{{ yn(doc.passport_oci) }}</td>\n            <td class=\"strict-label\">Upload Govt. ID (Passport for Foreign Nationals)</td>\n            <td style=\"text-align: center;\">{{ yn(doc.govt_id) }}</td>\n        </tr>\n    </table>\n\n    <div class=\"pf-section\">7. Declaration</div>\n    <table class=\"strict-table\">\n        <tr>\n            <td colspan=\"4\" style=\"padding: 15px; font-size: 10pt; line-height: 1.5; text-align: justify; border-bottom: none;\">\n                I certify that the information submitted by me in support of this application, is true to the best of knowledge and belief. I understand that in the event of any information being found false or incorrect, my admission is liable to be rejected / cancelled at any stage of the program. I undertake to abide by the disciplinary rules and regulations of the institute.\n            </td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\" style=\"width: 20%;\">I AGREE</td>\n            <td style=\"width: 30%; text-align: center;\">{{ yn_text(doc.i_agree) }}</td>\n            <td class=\"strict-label\" style=\"width: 20%;\">Applicant Name</td>\n            <td style=\"width: 30%; text-align: center;\">{{ f(doc.applicant_name) }}</td>\n        </tr>\n        <tr>\n            <td class=\"strict-label\">Date</td>\n            <td colspan=\"3\" style=\"text-align: center;\">{{ fd(doc.submission_date) }}</td>\n        </tr>\n    </table>\n    \n    <div style=\"padding: 10px; color: #999; font-size: 8pt;\">\n        Generated on: {{ frappe.utils.format_datetime(frappe.utils.now_datetime(), \"dd-MM-yyyy HH:mm:ss\") }}\n    </div>\n</div>\n",
