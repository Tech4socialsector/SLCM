 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    @media print {\n        @page { size: auto; margin: 10mm; }\n        .receipt-container { padding: 5mm; border: none; }\n        .receipt-outer-border { border: 1.5px solid #000; padding: 15px; }\n    }\n\n    .receipt-container {\n        font-family: Arial, Helvetica, sans-serif;\n        color: #000;\n        font-size: 11.5px;\n        line-height: 1.4;\n        width: 100%;\n        max-width: 800px;\n        margin: 0 auto;\n        padding: 20px;\n    }\n\n    .receipt-outer-border {\n        border: 1.5px solid #000;\n        padding: 25px;\n        min-height: 850px;\n        display: flex;\n        flex-direction: column;\n    }\n\n    /* Header Styles */\n    .receipt-header {\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        margin-bottom: 30px;\n        position: relative;\n        min-height: 100px;\n    }\n\n    .header-logo {\n        position: absolute;\n        left: 0;\n        top: 0;\n        width: 100px;\n        height: 100px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        font-weight: bold;\n        font-size: 18px;\n        color: #1a3c6e;\n    }\n\n    .header-logo img {\n        max-width: 100%;\n        max-height: 100%;\n        object-fit: contain;\n    }\n\n    .header-info {\n        text-align: center;\n        width: 100%;\n        padding: 0 110px; /* Ensure space for logo and symmetry */\n    }\n\n    .college-name {\n        font-size: 19px;\n        font-weight: bold;\n        text-transform: uppercase;\n        margin-bottom: 6px;\n    }\n\n    .college-address {\n        font-size: 13.5px;\n        font-weight: bold;\n        color: #000;\n        margin-bottom: 8px;\n        line-height: 1.3;\n    }\n\n    .college-phone {\n        font-size: 12.5px;\n        font-weight: bold;\n    }\n\n    /* Title Bar */\n    .title-bar {\n        text-align: center;\n        margin-bottom: 35px;\n        font-size: 14px;\n        font-weight: bold;\n        text-transform: uppercase;\n    }\n\n    /* Receipt Meta (No/Date) */\n    .receipt-meta {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 25px;\n        font-weight: bold;\n    }\n\n    /* Info Grid (Label : Value style) */\n    .info-grid {\n        margin-bottom: 35px;\n        padding-left: 60px;\n    }\n\n    .info-row {\n        display: flex;\n        margin-bottom: 6px;\n    }\n\n    .info-label {\n        width: 160px;\n        text-align: left;\n        color: #000;\n    }\n\n    .info-dots {\n        width: 20px;\n        text-align: center;\n    }\n\n    .info-value {\n        font-weight: normal;\n        color: #000;\n        flex: 1;\n    }\n\n    /* Table Styles */\n    .particulars-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 5px;\n    }\n\n    .particulars-table th, .particulars-table td {\n        border: 1px solid #ccc;\n        padding: 6px 10px;\n        text-align: left;\n    }\n\n    .particulars-table th {\n        background-color: #fff;\n        font-weight: bold;\n    }\n\n    .text-right { text-align: right !important; }\n    .text-center { text-align: center !important; }\n\n    .totals-row td {\n        border: none;\n        border-left: 1px solid #ccc;\n        border-right: 1px solid #ccc;\n        padding: 4px 10px;\n    }\n\n    .grand-total-row td {\n        border-top: 1px solid #ccc;\n        font-weight: bold;\n    }\n\n    .due-row td {\n        border-top: 1px solid #ccc;\n        border-bottom: 1px solid #ccc;\n    }\n\n    /* Footer Styles */\n    .receipt-footer {\n        margin-top: 5px;\n        font-size: 10.5px;\n    }\n\n    .amount-words {\n        font-style: normal;\n        margin-bottom: 40px;\n    }\n\n    .receipt-note {\n        margin-top: auto; /* Push to bottom */\n        padding-bottom: 20px;\n    }\n\n    .receipt-note strong {\n        font-style: italic;\n        text-decoration: underline;\n    }\n\n    .receipt-note ul {\n        margin: 5px 0;\n        padding-left: 20px;\n        list-style-type: disc;\n    }\n\n    .receipt-note li {\n        margin-bottom: 4px;\n        font-style: italic;\n        font-weight: bold;\n        line-height: 1.2;\n    }\n\n    .footer-disclaimer {\n        border-top: 1.5px solid #000;\n        padding-top: 8px;\n        text-align: center;\n        font-weight: bold;\n        font-style: italic;\n        font-size: 12px;\n    }\n\n</style>\n\n{% set app_doc = frappe.get_doc(\"Applicant\", doc.applicant) if doc.applicant else None %}\n{% set campus_id = app_doc.campus if app_doc else doc.campus %}\n{% set campus = frappe.get_doc(\"Campus\", campus_id) if campus_id else None %}\n\n<div class=\"receipt-container\">\n    <div class=\"receipt-outer-border\">\n        <!-- Header -->\n        <div class=\"receipt-header\">\n            <div class=\"header-logo\">\n                {% if campus and campus.logo %}\n                    <img src=\"{{ campus.logo }}\" alt=\"Logo\">\n                {% elif campus %}\n                    {{ campus.campus_code }}\n                {% else %}\n                    <div style=\"border: 2px solid #ccc; width: 60px; height: 60px; border-radius: 50%;\"></div>\n                {% endif %}\n            </div>\n            <div class=\"header-info\">\n                <div class=\"college-name\">{{ (campus.campus_name if campus else \" \") }}</div>\n                <div class=\"college-address\">\n                    {% if campus %}\n                        {{ campus.address or \"\" }}, {{ campus.city or \"\" }} - {{ campus.pincode or \" \" }}\n                    {% else %}\n                        NLSIU\n                    {% endif %}\n                </div>\n                {% if campus.phone_number %}\n                     <div class=\"college-phone\">\n                    Phone No : {{ campus.phone_number }}\n                </div>\n                {% endif %}\n               \n            </div>\n        </div>\n\n        <!-- Title -->\n        <div class=\"title-bar\">\n            RECEIPT\n        </div>\n\n        <!-- Meta Information -->\n        <div class=\"receipt-meta\">\n            <div>Receipt No : {{ doc.name }}</div>\n            <div>Date : {{ frappe.utils.formatdate(doc.payment_date, 'dd/MM/yyyy') }}</div>\n        </div>\n\n        <!-- Info Grid -->\n        <div class=\"info-grid\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">Name</span>\n                <span class=\"info-dots\">:</span>\n                <span class=\"info-value\">{{ doc.applicant_name }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">Programme</span>\n                <span class=\"info-dots\">:</span>\n                <span class=\"info-value\">{{ doc.program or \"\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">Application     No</span>\n                <span class=\"info-dots\">:</span>\n                <span class=\"info-value\">{{ doc.applicant or \"\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">Payment Mode</span>\n                <span class=\"info-dots\">:</span>\n                <span class=\"info-value\">{{ doc.payment_mode or \"Online\" }}</span>\n            </div>\n            {% if doc.transaction_id %}\n            <div class=\"info-row\">\n                <span class=\"info-label\">Transaction No</span>\n                <span class=\"info-dots\">:</span>\n                <span class=\"info-value\">{{ doc.transaction_id }}</span>\n            </div>\n            {% endif %}\n        </div>\n\n        <!-- Particulars Table -->\n        <table class=\"particulars-table\">\n            <thead>\n                <tr>\n                    <th style=\"width: 60px;\" class=\"text-center\">S.No</th>\n                    <th>Particulars</th>\n                    <th style=\"width: 160px;\" class=\"text-right\">Amount (\u20b9)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in doc.get(\"fee_components\") %}\n                <tr class=\"totals-row\">\n                    <td class=\"text-center\">{{ loop.index }}</td>\n                    <td>{{ doc.academic_year }} - {{ row.component_name }}</td>\n                    <td class=\"text-right\">{{ doc.get_formatted(\"total_amount\", row) }}</td>\n                </tr>\n                {% endfor %}\n                \n                <tr class=\"grand-total-row\">\n                    <td colspan=\"2\" class=\"text-right\">Gross Amount</td>\n                    <td class=\"text-right\">{{ doc.get_formatted(\"total_amount\") }}</td>\n                </tr>\n\n                {% if doc.scholarship_applied %}\n                <tr class=\"totals-row\">\n                    <td colspan=\"2\" class=\"text-right\">Scholarship Benefit (-)</td>\n                    <td class=\"text-right\">{{ doc.get_formatted(\"scholarship_amount\") }}</td>\n                </tr>\n                <tr class=\"grand-total-row\">\n                    <td colspan=\"2\" class=\"text-right\">Net Paid Amount</td>\n                    <td class=\"text-right\">{{ doc.get_formatted(\"net_amount\") }}</td>\n                </tr>\n                {% endif %}\n\n                <tr class=\"due-row\">\n                    <td colspan=\"2\" class=\"text-right\">Due Amount</td>\n                    <td class=\"text-right\">0.00</td>\n                </tr>\n            </tbody>\n        </table>\n\n        <!-- Amount in Words -->\n        <div class=\"receipt-footer\">\n            <div class=\"amount-words\">\n                {% set final_amt = doc.net_amount if doc.scholarship_applied else doc.total_amount %}\n                (Amount in words : {{ frappe.utils.money_in_words(final_amt, doc.currency or \"INR\") }})\n            </div>\n        </div>\n\n        <!-- Note Section -->\n        <div class=\"receipt-note\">\n            <strong>Note:</strong>\n            <ul>\n                <li>Transaction fee charges are non-refundable and non-reversible under any circumstances, including refunds, reversals, chargebacks, or any other reasons.</li>\n                <li>All transaction fees will be borne by the account/card holder for every payment made</li>\n            </ul>\n        </div>\n\n        <!-- Disclaimer -->\n        <div class=\"footer-disclaimer\">\n            This is a computer-generated receipt and no signature required\n        </div>\n    </div>\n</div>",
