{
 "doctype": "DocType",
 "name": "Admission Cycle",
 "module": "Admission",
 "autoname": "naming_series:",
 "naming_series": "CYCLE-.YYYY.-",
 "is_submittable": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Naming Series",
   "options": "CYCLE-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "cycle_name",
   "fieldtype": "Data",
   "label": "Cycle Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "admission_year",
   "fieldtype": "Link",
   "label": "Admission Year",
   "options": "Admission Year",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "workflow_type",
   "fieldtype": "Select",
   "label": "Workflow Type",
   "options": "\nCLAT\nNLSAT\nPACE",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "program",
   "fieldtype": "Link",
   "label": "Program",
   "options": "Program",
   "reqd": 1
  },
  {
   "fieldname": "degree_type",
   "fieldtype": "Select",
   "label": "Degree Type",
   "options": "\nBA LLB\nLLM\n3-Year LLB\nMPP\nPhD\nMBL"
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Start Date",
   "reqd": 1
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "End Date",
   "reqd": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "\nDraft\nActive\nClosed",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "clat_consortium_code",
   "fieldtype": "Data",
   "label": "CLAT Consortium Code",
   "depends_on": "eval:doc.workflow_type=='CLAT'",
   "mandatory_depends_on": "eval:doc.workflow_type=='CLAT'"
  },
  {
   "fieldname": "nlsat_exam_date",
   "fieldtype": "Date",
   "label": "NLSAT Exam Date",
   "depends_on": "eval:doc.workflow_type=='NLSAT'",
   "mandatory_depends_on": "eval:doc.workflow_type=='NLSAT'"
  },
  {
   "fieldname": "total_seats",
   "fieldtype": "Int",
   "label": "Total Seats",
   "reqd": 1
  },
  {
   "fieldname": "reservation_matrix",
   "fieldtype": "Table",
   "label": "Reservation Matrix",
   "options": "Reservation Category"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1
  },
  {
   "role": "Admission Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1
  },
  {
   "role": "Admission Officer",
   "read": 1
  }
 ]
}