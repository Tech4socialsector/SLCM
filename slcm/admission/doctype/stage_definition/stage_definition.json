{
  "doctype": "DocType",
  "name": "Stage Definition",
  "module": "Admission",
  "istable": 1,
  "fields": [
    {"fieldname": "stage_name", "fieldtype": "Data", "label": "Stage Name", "reqd": 1, "in_list_view": 1, "description": "Free text — partner names their own stages"},
    {"fieldname": "stage_type", "fieldtype": "Select", "label": "Stage Type", "options": "\nApplication\nScreening\nExam\nInterview\nEvaluation\nMerit\nDocument\nFee\nEnrollment", "reqd": 1, "in_list_view": 1, "description": "Drives system behaviour for this stage"},
    {"fieldname": "sequence", "fieldtype": "Int", "label": "Sequence", "reqd": 1, "in_list_view": 1},
    {"fieldname": "is_mandatory", "fieldtype": "Check", "label": "Mandatory Stage", "default": "0"},
    {"fieldname": "is_enabled", "fieldtype": "Check", "label": "Enabled", "default": "1", "in_list_view": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "evaluation_config", "fieldtype": "Link", "label": "Evaluation Config", "options": "Evaluation Config", "depends_on": "eval:['Interview','Evaluation'].includes(doc.stage_type)"},
    {"fieldname": "deadline_offset_days", "fieldtype": "Int", "label": "Deadline Offset (Days)", "description": "Auto-set deadline N days from cycle start"},
    {"fieldname": "section_break_notify", "fieldtype": "Section Break", "label": "Notifications"},
    {"fieldname": "notify_applicant_on_entry", "fieldtype": "Check", "label": "Notify Applicant on Entry", "default": "0"},
    {"fieldname": "notification_template", "fieldtype": "Link", "label": "Notification Template", "options": "Email Template Config", "depends_on": "eval:doc.notify_applicant_on_entry==1"},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "responsible_role", "fieldtype": "Link", "label": "Responsible Role", "options": "Role"},
    {"fieldname": "requires_approval_to_unlock", "fieldtype": "Check", "label": "Requires Approval to Unlock Next Stage", "default": "0"}
  ]
}