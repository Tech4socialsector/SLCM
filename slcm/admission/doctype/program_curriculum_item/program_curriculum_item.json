{
  "name": "Program Curriculum Item",
  "doctype": "DocType",
  "module": "Admission",
  "istable": 1,
  "editable_grid": 1,
  "fields": [
    {
      "fieldname": "year_label",
      "fieldtype": "Data",
      "label": "Year / Semester Label",
      "in_list_view": 1,
      "reqd": 1,
      "description": "e.g. Year 1: Foundations"
    },
    {
      "fieldname": "credits",
      "fieldtype": "Data",
      "label": "Credits",
      "in_list_view": 1,
      "description": "e.g. 40 Credits"
    },
    {
      "fieldname": "subjects",
      "fieldtype": "Text",
      "label": "Subjects (one per line)",
      "in_list_view": 1,
      "description": "Enter each subject on a new line"
    },
    {
      "fieldname": "is_expanded",
      "fieldtype": "Check",
      "label": "Show expanded by default",
      "default": 0
    }
  ],
  "permissions": [
    {"role": "System Manager",  "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Admission Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
