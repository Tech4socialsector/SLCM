{
  "name": "Program Media",
  "doctype": "DocType",
  "module": "Admission",
  "istable": 1,
  "editable_grid": 1,
  "fields": [
    {
      "fieldname": "media_type",
      "fieldtype": "Select",
      "label": "Type",
      "options": "Image\nVideo",
      "default": "Image",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "media_url",
      "fieldtype": "Attach",
      "label": "File URL (Image or Video)",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "external_url",
      "fieldtype": "Data",
      "label": "External Video URL (YouTube/Vimeo embed)",
      "description": "Use for YouTube: https://www.youtube.com/embed/VIDEO_ID"
    },
    {
      "fieldname": "caption",
      "fieldtype": "Data",
      "label": "Caption",
      "in_list_view": 1
    },
    {
      "fieldname": "is_hero",
      "fieldtype": "Check",
      "label": "Use as Hero Image",
      "default": 0
    },
    {
      "fieldname": "sort_order",
      "fieldtype": "Int",
      "label": "Sort Order",
      "default": 0
    }
  ],
  "permissions": [
    {"role": "System Manager",  "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Admission Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
