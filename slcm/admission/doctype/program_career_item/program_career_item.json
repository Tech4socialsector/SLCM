{
  "name": "Program Career Item",
  "doctype": "DocType",
  "module": "Admission",
  "istable": 1,
  "editable_grid": 1,
  "fields": [
    {
      "fieldname": "role_title",
      "fieldtype": "Data",
      "label": "Role Title",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "icon",
      "fieldtype": "Data",
      "label": "Material Symbol Icon",
      "in_list_view": 1,
      "description": "e.g. code, psychology, shield, cloud"
    },
    {
      "fieldname": "salary_range",
      "fieldtype": "Data",
      "label": "Salary / Package",
      "in_list_view": 1,
      "description": "e.g. ₹8-15 LPA or $120k+"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {"role": "System Manager",  "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Admission Admin", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
