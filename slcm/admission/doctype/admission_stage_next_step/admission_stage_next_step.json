{
  "name": "Admission Stage Next Step",
  "doctype": "DocType",
  "module": "Admission",
  "istable": 1,
  "editable_grid": 1,
  "fields": [
    {
      "fieldname": "stage_name",
      "fieldtype": "Data",
      "label": "Stage Name",
      "in_list_view": 1,
      "reqd": 1,
      "description": "Must match the stage name exactly as it appears in Admission Stage Config"
    },
    {
      "fieldname": "step_text",
      "fieldtype": "Small Text",
      "label": "Next Step Text",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "is_link",
      "fieldtype": "Check",
      "label": "Is Link?",
      "default": 0
    },
    {
      "fieldname": "link_url",
      "fieldtype": "Data",
      "label": "Link URL",
      "depends_on": "is_link"
    },
    {
      "fieldname": "link_label",
      "fieldtype": "Data",
      "label": "Link Label",
      "depends_on": "is_link"
    }
  ],
  "permissions": [
    { "role": "System Manager",  "read": 1, "write": 1, "create": 1, "delete": 1 },
    { "role": "Admission Admin", "read": 1, "write": 1, "create": 1, "delete": 1 }
  ]
}
