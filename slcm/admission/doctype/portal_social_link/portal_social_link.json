{
  "name": "Portal Social Link",
  "doctype": "DocType",
  "module": "Admission",
  "istable": 1,
  "editable_grid": 1,
  "fields": [
    {
      "fieldname": "platform",
      "fieldtype": "Select",
      "label": "Platform",
      "options": "Facebook\nInstagram\nX (Twitter)\nLinkedIn\nYouTube\nWhatsApp\nTelegram\nThreads\nPinterest\nTikTok",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "url",
      "fieldtype": "Data",
      "label": "Profile URL",
      "options": "URL",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1
    }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1 },
    { "role": "Admission Admin", "read": 1, "write": 1, "create": 1, "delete": 1 }
  ]
}
