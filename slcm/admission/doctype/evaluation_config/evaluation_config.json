{
  "doctype": "DocType",
  "name": "Evaluation Config",
  "module": "Admission",
  "track_changes": 1,
  "autoname": "field:config_name",
  "title_field": "config_name",
  "fields": [
    {"fieldname": "config_name", "fieldtype": "Data", "label": "Config Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "evaluation_type", "fieldtype": "Select", "label": "Evaluation Type", "options": "\nPanel Interview\nWritten Test\nGD\nResearch Proposal\nPortfolio Review\nAutomated Cutoff", "reqd": 1, "in_list_view": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "min_evaluators", "fieldtype": "Int", "label": "Min Evaluators Required", "default": "1"},
    {"fieldname": "max_evaluators", "fieldtype": "Int", "label": "Max Evaluators", "default": "5"},
    {"fieldname": "section_break_slot", "fieldtype": "Section Break", "label": "Slot Booking"},
    {"fieldname": "allow_slot_booking", "fieldtype": "Check", "label": "Allow Applicant Slot Booking", "default": "0"},
    {"fieldname": "slot_duration_minutes", "fieldtype": "Int", "label": "Slot Duration (Minutes)", "default": "30", "depends_on": "eval:doc.allow_slot_booking==1"},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "auto_shortlist_cutoff", "fieldtype": "Float", "label": "Auto-Shortlist Cutoff Score", "description": "Applicants scoring >= this are auto-shortlisted"},
    {"fieldname": "result_visibility", "fieldtype": "Select", "label": "Result Visibility", "options": "\nImmediate\nAfter All Complete\nAdmin Publishes", "default": "Admin Publishes"},
    {"fieldname": "section_break_components", "fieldtype": "Section Break", "label": "Scoring Components"},
    {"fieldname": "scoring_components", "fieldtype": "Table", "label": "Scoring Components", "options": "Score Component"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Admission Admin", "read": 1, "write": 1, "create": 1}
  ]
}