   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description / Notes"
  },
  {
   "fieldname": "section_cgpa",
   "fieldtype": "Section Break",
   "label": "CGPA / GPA Criteria",
   "collapsible": 0
  },
  {
   "fieldname": "enable_cgpa_check",
   "fieldtype": "Check",
   "label": "Enable CGPA Check",
   "default": "0",
   "description": "Toggle on to enforce a minimum CGPA requirement"
  },
  {
   "fieldname": "col_break_cgpa",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "min_cgpa",
   "fieldtype": "Float",
   "label": "Minimum CGPA Required",
   "depends_on": "eval:doc.enable_cgpa_check",
   "description": "Student must have CGPA >= this value to be promoted"
  },
  {
   "fieldname": "section_backlog",
   "fieldtype": "Section Break",
   "label": "Backlog / Failed Courses Criteria"
  },
  {
   "fieldname": "enable_backlog_check",
   "fieldtype": "Check",
   "label": "Enable Backlog Check",
   "default": "0",
   "description": "Toggle on to enforce a maximum backlog (failed course) limit"
  },
  {
   "fieldname": "col_break_backlog",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "max_backlogs_allowed",
   "fieldtype": "Int",
   "label": "Maximum Backlogs Allowed",
   "default": "0",
   "depends_on": "eval:doc.enable_backlog_check",
   "description": "Set 0 to require zero backlogs. Students with more than this number will not be promoted."
  },
  {
   "fieldname": "section_attendance",
   "fieldtype": "Section Break",
   "label": "Attendance Criteria"
  },
  {
   "fieldname": "enable_attendance_check",
   "fieldtype": "Check",
   "label": "Enable Attendance Check",
   "default": "0",
   "description": "Toggle on to enforce a minimum attendance percentage"
  },
  {
   "fieldname": "col_break_attendance",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "min_attendance_percent",
   "fieldtype": "Float",
   "label": "Minimum Attendance % Required",
   "depends_on": "eval:doc.enable_attendance_check",
   "description": "e.g. 75 means the student must have attended at least 75% of classes"
  },
  {
   "fieldname": "section_shortage",
   "fieldtype": "Section Break",
   "label": "Attendance Shortage by Course"
  },
  {
   "fieldname": "enable_course_shortage_check",
   "fieldtype": "Check",
   "label": "Enable Course Shortage Check",
   "default": "0",
   "description": "Toggle on to limit the number of courses where a student has attendance shortage"
  },
  {
   "fieldname": "col_break_shortage",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "max_shortage_courses",
   "fieldtype": "Int",
   "label": "Max Courses with Attendance Shortage",
   "default": "2",
   "depends_on": "eval:doc.enable_course_shortage_check",
   "description": "Student must not have shortage in more than this many courses (e.g. 2 means up to 2 shortage courses allowed)"
  },
  {
   "fieldname": "section_cf",
   "fieldtype": "Section Break",
   "label": "Carry-Forward Course: FA + Shortage Check"
  },
  {
   "fieldname": "enable_cf_check",
   "fieldtype": "Check",
   "label": "Enable Carry-Forward FA + Shortage Check",
   "default": "0",
   "description": "Toggle on to flag students who have FA/MFA condonation applied but are still not exam-eligible in any course (FA applied + shortage persists)"
  },
  {
   "fieldname": "col_break_cf",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "max_cf_fa_shortage",
   "fieldtype": "Int",
   "label": "Max Allowed CF Courses with FA + Shortage",
   "default": "0",
   "depends_on": "eval:doc.enable_cf_check",
   "description": "Set 0 to require zero such courses. Students with more than this number will not be promoted."
  },
  {
   "fieldname": "section_conditional",
   "fieldtype": "Section Break",
   "label": "Advanced Settings"
  },
  {
   "fieldname": "conditional_promotion_action",
   "fieldtype": "Select",
   "label": "When Criteria Partially Fail",
   "options": "Not Promoted\nConditional (Pending Review)",
   "default": "Not Promoted",
   "description": "If a student fails some but not all criteria, mark them as this status instead of immediately Not Promoted"
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "auto_update_student_year",
   "fieldtype": "Check",
   "label": "Auto-update Student Year on Confirm",
   "default": "1",
   "description": "When promotion is confirmed, automatically update current_year on Student Master for promoted students"
  }
 ],
